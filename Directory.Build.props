<Project>

  <!-- Shared by every project in the solution. Keep project files tiny. -->

  <PropertyGroup Label="Language">
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Identity">
    <Product>Tsume</Product>
    <Company>Tsume contributors</Company>
    <Copyright>Copyright (C) 2026 Tsume contributors. GPL-3.0-only.</Copyright>
    <Version>1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <!-- One tidy artifacts/ folder instead of bin/ and obj/ in every project. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
