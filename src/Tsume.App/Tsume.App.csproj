<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Tsume</AssemblyName>
    <RootNamespace>Tsume.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\assets\Tsume.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Label="Languages">
    <!-- Language\Strings.resx (English) is built into Tsume.exe; each Strings.<code>.resx becomes <code>\Tsume.resources.dll. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Stay small">
    <!-- Tsume idles beside a game: favour a small footprint over throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup Label="Stay small">
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsume.Core\Tsume.Core.csproj" />
    <ProjectReference Include="..\Tsume.Upscaling\Tsume.Upscaling.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
