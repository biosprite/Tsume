<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Tsume</AssemblyName>
    <RootNamespace>Tsume.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\assets\Tsume.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Label="Languages">
    <!-- Language\Strings.resx (English) is built into Tsume.exe; each Strings.<code>.resx becomes <code>\Tsume.resources.dll. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Stay small">
    <!-- Tsume idles beside a game: favour a small footprint over throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup Label="Stay small">
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsume.Core\Tsume.Core.csproj" />
    <ProjectReference Include="..\Tsume.Upscaling\Tsume.Upscaling.csproj" />
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="RTSS overlay layouts">
    <!-- Combined Essential Dark overlay (realHfde, MIT) + stitched atlas (all 4 levels) drawn by RTSS OverlayEditor. -->
    <None Include="Overlays\Essential\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Overlays\Essential\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Overlays\Essential\essential_tsume.ovl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Overlays\Essential\essential_tsume_atlas.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
