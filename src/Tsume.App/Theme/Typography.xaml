<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Both fonts ship with Windows 11. -->
  <FontFamily x:Key="Font.Words">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Words}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- The clock -->
  <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The name of a screen -->
  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Compact title and breadcrumb segments for Settings screens; fits 1–2 wrapped lines inside the 46px header. -->
  <Style x:Key="Text.ScreenTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.ScreenCrumb" TargetType="TextBlock" BasedOn="{StaticResource Text.ScreenTitle}" />

  <Style x:Key="Text.ScreenCrumbSeparator" TargetType="TextBlock" BasedOn="{StaticResource Text.ScreenTitle}">
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <!-- Everyday text -->
  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Supporting text -->
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>

  <!-- SECTION HEADINGS -->
  <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
    <Setter Property="Margin" Value="4,0,0,10" />
  </Style>

  <!-- Labels inside the segmented control -->
  <Style x:Key="Text.Segment" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
