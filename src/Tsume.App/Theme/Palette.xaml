<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The default scheme. Theme/Colours.cs replaces these brushes at run time, so reference them with
       DynamicResource. Signal colours and radii never change and may be static. The accent is in Accent.cs. -->

  <!-- The panel itself -->
  <SolidColorBrush x:Key="Panel.Fill" Color="#F513151A" />
  <SolidColorBrush x:Key="Panel.Edge" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Panel.Scrim" Color="#B80A0B0E" />
  <SolidColorBrush x:Key="Sheet.Fill"  Color="#FF1B1E25" />

  <!-- Things that sit on the panel -->
  <SolidColorBrush x:Key="Surface"         Color="#0EFFFFFF" />
  <SolidColorBrush x:Key="Surface.Hover"   Color="#18FFFFFF" />
  <SolidColorBrush x:Key="Surface.Divider" Color="#14FFFFFF" />

  <!-- A switch: its groove, and the knob once it is on (dark, to sit on the accent) -->
  <SolidColorBrush x:Key="Switch.Groove" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Switch.KnobOn" Color="#0B0D11" />

  <!-- Text -->
  <SolidColorBrush x:Key="Text"       Color="#F4F6FA" />
  <SolidColorBrush x:Key="Text.Muted" Color="#8E96A6" />
  <SolidColorBrush x:Key="Text.Faint" Color="#5C6472" />

  <!-- Meaning -->
  <SolidColorBrush x:Key="Signal.Good"   Color="#3DDC97" />
  <SolidColorBrush x:Key="Signal.Warn"   Color="#F5B841" />
  <SolidColorBrush x:Key="Signal.Danger" Color="#FF5D5D" />

  <!-- Shape -->
  <CornerRadius x:Key="Radius.Panel">26</CornerRadius>
  <CornerRadius x:Key="Radius.Control">18</CornerRadius>
  <CornerRadius x:Key="Radius.Thumb">13</CornerRadius>

</ResourceDictionary>
