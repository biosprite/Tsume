<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Tsume.App.Controls"
                    xmlns:theme="clr-namespace:Tsume.App.Theme"
                    xmlns:lang="clr-namespace:Tsume.App.Language">

  <!-- The accent brushes animate, and WPF freezes a snapshot of anything placed in a Style setter,
       so set accent colours directly on an element, never through a setter. -->

  <Style x:Key="Focus.Ring" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Storyboard x:Key="Ring.Show">
    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
  </Storyboard>

  <Storyboard x:Key="Ring.Hide">
    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
  </Storyboard>

  <Style TargetType="controls:SegmentedControl">
    <Setter Property="Height" Value="50" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SegmentedControl">
          <Grid>
            <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}" Padding="5">
              <Grid>
                <Border x:Name="PART_Thumb"
                        HorizontalAlignment="Left"
                        CornerRadius="{StaticResource Radius.Thumb}"
                        Background="{x:Static theme:Accent.Brush}" />
                <UniformGrid x:Name="PART_Labels" Rows="1" />
              </Grid>
            </Border>
            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:SwatchPicker">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SwatchPicker">
          <StackPanel>
            <Grid>
              <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}" Padding="14,10,14,10">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Body}" Text="{TemplateBinding Label}" Margin="4,0,0,6" />
                  <UniformGrid x:Name="PART_Swatches" Rows="1" />
                </StackPanel>
              </Border>
              <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
            </Grid>

            <!-- Custom colour: hue, then saturation. Each slider is its own focus stop. -->
            <controls:SpectrumSlider Part="Hue" Margin="0,6,0,0"
                                     AutomationProperties.Name="{x:Static lang:Strings.Hue}"
                                     Colour="{Binding SelectedColour, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
            <controls:SpectrumSlider Part="Saturation" Margin="0,6,0,0"
                                     AutomationProperties.Name="{x:Static lang:Strings.Saturation}"
                                     Colour="{Binding SelectedColour, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The colour strips under a swatch picker. -->
  <Style TargetType="controls:SpectrumSlider">
    <Setter Property="Height" Value="36" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SpectrumSlider">
          <Grid Background="Transparent">
            <!-- Inset so the focus ring sits on the dark background, not the strip. -->
            <Grid x:Name="PART_Track" Margin="4">
              <Border x:Name="PART_Strip" CornerRadius="14" />

              <Grid x:Name="PART_Thumb" Width="28" Height="28" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Ellipse Fill="#50000000" />
                <Ellipse x:Name="PART_Dot" Margin="1" Stroke="White" StrokeThickness="3" />
              </Grid>
            </Grid>
            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:LevelSlider">
    <Setter Property="Height" Value="48" />
    <Setter Property="SmallChange" Value="1" />
    <!-- One step per d-pad tap; LevelSlider accelerates while it is held. -->
    <Setter Property="LargeChange" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:LevelSlider">
          <Grid Background="Transparent">
            <Border x:Name="PART_Track" Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}">
              <Grid>
                <Border x:Name="PART_Fill" HorizontalAlignment="Left" Background="{x:Static theme:Accent.Wash}" />

                <DockPanel Margin="18,0" IsHitTestVisible="False">
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="{TemplateBinding Glyph}" />

                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Body}" VerticalAlignment="Center">
                    <Run Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text="{Binding Unit, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                  </TextBlock>

                  <TextBlock Style="{StaticResource Text.Body}" Text="{TemplateBinding Label}"
                             Margin="12,0" VerticalAlignment="Center" />
                </DockPanel>
              </Grid>
            </Border>
            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:Tile">
    <Setter Property="Height" Value="78" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Tile">
          <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>

            <Border x:Name="Face" Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}" />
            <Border x:Name="Wash" Background="{x:Static theme:Accent.Wash}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" />

            <StackPanel Orientation="{TemplateBinding Orientation}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
              <Grid HorizontalAlignment="Center">
                <TextBlock x:Name="Icon" Style="{StaticResource Text.Icon}" FontSize="20"
                           Text="{TemplateBinding Glyph}" />
                <TextBlock x:Name="IconLit" Style="{StaticResource Text.Icon}" FontSize="20"
                           Text="{TemplateBinding Glyph}" Foreground="{x:Static theme:Accent.Brush}" Opacity="0" />
              </Grid>
              <StackPanel x:Name="Words" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                           Text="{TemplateBinding Label}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Detail" Style="{StaticResource Text.Caption}" FontSize="11"
                           Text="{TemplateBinding Detail}" HorizontalAlignment="Center" Margin="0,1,0,0" />
              </StackPanel>
            </StackPanel>

            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="Detail" Value="">
              <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="Words" Property="Margin" Value="12,0,0,0" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsOn" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="IconLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="IconLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.93" Duration="0:0:0.09" />
                    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.93" Duration="0:0:0.09" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.32">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.32">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:Sheet">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Sheet">
          <Grid>
            <!-- Dims the panel; a tap on it closes the sheet. -->
            <Border x:Name="PART_Scrim" Opacity="0"
                    Background="{DynamicResource Panel.Scrim}"
                    CornerRadius="{StaticResource Radius.Panel}" />

            <Border x:Name="PART_Card" Opacity="0"
                    VerticalAlignment="Bottom" Margin="14" Padding="10"
                    Background="{DynamicResource Sheet.Fill}"
                    BorderBrush="{DynamicResource Panel.Edge}" BorderThickness="1"
                    CornerRadius="22">
              <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                <TextBlock Style="{StaticResource Text.Heading}" Text="{TemplateBinding Title}" Margin="10,8,0,8" />
                <ContentPresenter />
              </StackPanel>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A short, wide tile with the icon beside the words -->
  <Style x:Key="Tile.Row" TargetType="controls:Tile" BasedOn="{StaticResource {x:Type controls:Tile}}">
    <Setter Property="Height" Value="52" />
    <Setter Property="Orientation" Value="Horizontal" />
  </Style>

  <!-- Wide controls shrink less when pressed (0.97, not 0.93). -->
  <Storyboard x:Key="Press.Down">
    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.09" />
    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.09" />
  </Storyboard>

  <Storyboard x:Key="Press.Up">
    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.32">
      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
    <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.32">
      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>

  <!-- Compact pill-like button for secondary links (e.g. external compatibility lists). -->
  <Style x:Key="Tile.Mini" TargetType="controls:Tile">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Tile">
          <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>

            <Border x:Name="Face" Background="{DynamicResource Surface}" CornerRadius="12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False">
              <TextBlock Style="{StaticResource Text.Icon}" FontSize="12"
                         Foreground="{DynamicResource Text.Muted}"
                         Text="{TemplateBinding Glyph}" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                         Text="{TemplateBinding Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" CornerRadius="12"
                    BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Press.Down}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Press.Up}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Switch card: icon, name, a detail line, and a switch driven by IsOn. Grows if the text wraps. -->
  <Style x:Key="Tile.Switch" TargetType="controls:Tile">
    <Setter Property="MinHeight" Value="70" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Tile">
          <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>

            <Border x:Name="Face" Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}" />

            <DockPanel Margin="18,13,16,13">

              <Grid DockPanel.Dock="Right" Width="46" Height="26" VerticalAlignment="Center">
                <Border Background="{DynamicResource Switch.Groove}" CornerRadius="13" />
                <Border x:Name="GrooveLit" Background="{x:Static theme:Accent.Brush}" CornerRadius="13" Opacity="0" />

                <Grid x:Name="Knob" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Grid.RenderTransform>
                    <TranslateTransform />
                  </Grid.RenderTransform>
                  <Ellipse Fill="{DynamicResource Text.Muted}" />
                  <Ellipse x:Name="KnobLit" Fill="{DynamicResource Switch.KnobOn}" Opacity="0" />
                </Grid>
              </Grid>

              <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Width="22">
                <TextBlock x:Name="Icon" Style="{StaticResource Text.Icon}" FontSize="20"
                           HorizontalAlignment="Center" Text="{TemplateBinding Glyph}" />
                <TextBlock x:Name="IconLit" Style="{StaticResource Text.Icon}" FontSize="20"
                           HorizontalAlignment="Center" Text="{TemplateBinding Glyph}"
                           Foreground="{x:Static theme:Accent.Brush}" Opacity="0" />
              </Grid>

              <StackPanel Margin="14,0,14,0" VerticalAlignment="Center">
                <WrapPanel>
                  <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None"
                             Text="{TemplateBinding Label}" />

                  <!-- A small tag after the name, e.g. "EXPERIMENTAL". Set through Tag. -->
                  <Border x:Name="Badge" Margin="8,0,0,0" Padding="6,1,6,2" VerticalAlignment="Center"
                          CornerRadius="4" BorderThickness="1" BorderBrush="{x:Static theme:Accent.Brush}">
                    <TextBlock Style="{StaticResource Text.Heading}" Margin="0" FontSize="10"
                               Foreground="{x:Static theme:Accent.Brush}" Text="{TemplateBinding Tag}" />
                  </Border>
                </WrapPanel>
                <TextBlock x:Name="Detail" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                           Text="{TemplateBinding Detail}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>

            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="Detail" Value="">
              <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsOn" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="20" Duration="0:0:0.24">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GrooveLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="KnobLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="IconLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.24">
                      <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GrooveLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="KnobLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="IconLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Press.Down}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Press.Up}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Link card: a switch card with a glyph in place of the switch. The glyph is a chevron unless
       Tag names another. IsOn lights the icon. -->
  <Style x:Key="Tile.Link" TargetType="controls:Tile">
    <Setter Property="MinHeight" Value="62" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Tag" Value="{x:Static theme:Glyphs.Chevron}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Tile">
          <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>

            <Border x:Name="Face" Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}" />

            <DockPanel Margin="18,11,16,11" IsHitTestVisible="False">

              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" FontSize="12"
                         Foreground="{DynamicResource Text.Faint}" Text="{TemplateBinding Tag}" />

              <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Width="22">
                <TextBlock x:Name="Icon" Style="{StaticResource Text.Icon}" FontSize="20"
                           HorizontalAlignment="Center" Text="{TemplateBinding Glyph}" />
                <TextBlock x:Name="IconLit" Style="{StaticResource Text.Icon}" FontSize="20"
                           HorizontalAlignment="Center" Text="{TemplateBinding Glyph}"
                           Foreground="{x:Static theme:Accent.Brush}" Opacity="0" />
              </Grid>

              <StackPanel Margin="14,0,14,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" Text="{TemplateBinding Label}" />
                <TextBlock x:Name="Detail" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                           Text="{TemplateBinding Detail}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>

            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="Detail" Value="">
              <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsOn" Value="True">
              <Setter TargetName="IconLit" Property="Opacity" Value="1" />
              <Setter TargetName="Icon" Property="Opacity" Value="0" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Press.Down}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Press.Up}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Game row card: same chrome as Tile.Link, with custom badge content below the game's name. -->
  <Style x:Key="Tile.GameLink" TargetType="controls:Tile">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Tag" Value="{x:Static theme:Glyphs.Chevron}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Tile">
          <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>

            <Border x:Name="Face" Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}" />

            <DockPanel Margin="18,11,16,11" IsHitTestVisible="False">

              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" FontSize="12"
                         Foreground="{DynamicResource Text.Faint}" Text="{TemplateBinding Tag}" />

              <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Width="22">
                <TextBlock x:Name="Icon" Style="{StaticResource Text.Icon}" FontSize="20"
                           HorizontalAlignment="Center" Text="{TemplateBinding Glyph}" />
                <TextBlock x:Name="IconLit" Style="{StaticResource Text.Icon}" FontSize="20"
                           HorizontalAlignment="Center" Text="{TemplateBinding Glyph}"
                           Foreground="{x:Static theme:Accent.Brush}" Opacity="0" />
              </Grid>

              <StackPanel Margin="14,0,14,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" Text="{TemplateBinding Label}" />
                <ContentPresenter Margin="0,5,0,0" />
              </StackPanel>
            </DockPanel>

            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsOn" Value="True">
              <Setter TargetName="IconLit" Property="Opacity" Value="1" />
              <Setter TargetName="Icon" Property="Opacity" Value="0" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Press.Down}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Press.Up}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Preset: previews a colour scheme, passed in as the tile's Background, BorderBrush (the accent)
       and Foreground. IsOn ticks it. -->
  <Style x:Key="Tile.Preset" TargetType="controls:Tile">
    <Setter Property="Height" Value="66" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Tile">
          <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>

            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"
                    BorderBrush="{DynamicResource Panel.Edge}" BorderThickness="1" />

            <StackPanel VerticalAlignment="Center">
              <Grid Width="22" Height="22" HorizontalAlignment="Center">
                <Ellipse Fill="{TemplateBinding BorderBrush}" />
                <TextBlock x:Name="Tick" Style="{StaticResource Text.Icon}" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" Opacity="0"
                           Foreground="{TemplateBinding Background}"
                           Text="{x:Static theme:Glyphs.Tick}" />
              </Grid>
              <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Margin="2,6,2,0"
                         HorizontalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Label}" />
            </StackPanel>

            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsOn" Value="True">
              <Setter TargetName="Tick" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Press.Down}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Press.Up}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Note card: a box of status text. Takes no focus. -->
  <Style x:Key="Card.Note" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="18,14,18,14" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- Compact warning banner: subtle amber tint, takes no focus. -->
  <Style x:Key="Card.Warning" TargetType="Border">
    <Setter Property="Background" Value="#1AF5B841" />
    <Setter Property="BorderBrush" Value="#55F5B841" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,10,14,10" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <!-- Compact info banner: takes no focus. Set live accent Background/BorderBrush on the element. -->
  <Style x:Key="Card.Info" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,8,14,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- Icon button: round, icon only, sized for touch. -->
  <Style x:Key="Tile.Icon" TargetType="controls:Tile">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:Tile">
          <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>

            <Border x:Name="Face" Background="{DynamicResource Surface}" CornerRadius="23" />
            <TextBlock Style="{StaticResource Text.Icon}" FontSize="16"
                       HorizontalAlignment="Center" Text="{TemplateBinding Glyph}" />
            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" CornerRadius="23"
                    BorderBrush="{x:Static theme:Accent.Brush}" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Press.Down}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Press.Up}" /></Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dropdown list for keys and button actions: matches Tile surface, touch- and gamepad-friendly. -->
  <Style TargetType="controls:KeyDropdown">
    <Setter Property="Height" Value="42" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="VirtualizingPanel.CacheLength" Value="2,2" />
    <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Height" Value="40" />
          <Setter Property="Padding" Value="14,8" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Grid Margin="4,1">
                  <Border x:Name="Face" Background="Transparent" CornerRadius="10" />
                  <Border x:Name="SelectedWash" Background="{x:Static theme:Accent.Wash}" CornerRadius="10" Opacity="0" />
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                  <Border x:Name="ItemRing" CornerRadius="10" BorderThickness="1.5"
                          BorderBrush="{x:Static theme:Accent.Brush}" Opacity="0" IsHitTestVisible="False" />
                </Grid>

                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="SelectedWash" Property="Opacity" Value="1" />
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ItemRing" Property="Opacity" Value="1" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:KeyDropdown">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border x:Name="Face" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Panel.Edge}" BorderThickness="1"
                            CornerRadius="12" />
                    <DockPanel Margin="14,0,12,0">
                      <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Style="{StaticResource Text.Icon}"
                                 FontSize="12" Foreground="{DynamicResource Text.Muted}"
                                 Text="{x:Static theme:Glyphs.ChevronDown}"
                                 RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                          <RotateTransform Angle="0" />
                        </TextBlock.RenderTransform>
                      </TextBlock>
                      <Border />
                    </DockPanel>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Face" Property="Background" Value="{DynamicResource Surface.Hover}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="180" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter Margin="14,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

            <Border x:Name="Ring" Style="{StaticResource Focus.Ring}" CornerRadius="12"
                    BorderBrush="{x:Static theme:Accent.Brush}" />

            <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-14" VerticalOffset="-2"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                   StaysOpen="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Grid Margin="14,6,14,18">
                <Border Background="#FF0A0B0E" CornerRadius="14">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.55" Color="Black" />
                  </Border.Effect>
                  <Border.CacheMode>
                    <BitmapCache />
                  </Border.CacheMode>
                </Border>
                <Border MinWidth="{TemplateBinding ActualWidth}" MaxWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="300" Padding="0,4"
                        Background="{DynamicResource Sheet.Fill}"
                        BorderBrush="{DynamicResource Panel.Edge}" BorderThickness="1"
                        CornerRadius="14">
                  <ScrollViewer x:Name="PART_DropDownScroll" Focusable="False"
                                CanContentScroll="True" PanningMode="VerticalOnly"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Hidden">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
