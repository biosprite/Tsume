<UserControl x:Class="Tsume.App.Panel.UpscalingBuildScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- The OptiScaler build on this machine: fetch the newest nightly, update games, XMX, extras. -->

  <DockPanel DataContext="{Binding Upscaling.Build}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.OptiScalerBuild}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
               Text="{Binding Status}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <Border Style="{StaticResource Card.Note}">
          <StackPanel>
            <WrapPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.Body}" Text="{Binding BuildLine}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border Background="{DynamicResource Surface.Hover}"
                      BorderBrush="{DynamicResource Surface.Divider}"
                      BorderThickness="1" CornerRadius="4" Padding="6,1.5"
                      VerticalAlignment="Center"
                      Visibility="{Binding VersionLineShown}">
                <TextBlock Style="{StaticResource Text.Caption}" FontSize="11"
                           Foreground="{DynamicResource Text.Muted}"
                           Text="{Binding VersionLine}" VerticalAlignment="Center" />
              </Border>
            </WrapPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Faint}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{x:Static lang:Strings.NightlyExplained}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- Checking for a newer nightly build: small Hardware Discovery-style loading ring. -->
        <Border Style="{StaticResource Card.Info}"
                Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                Padding="16,12"
                Visibility="{Binding CheckingShown}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ProgressRing Grid.Column="0" Width="16" Height="16" RingThickness="2"
                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{x:Static theme:Accent.Brush}"
                                   TrackBrush="{DynamicResource Switch.Groove}"
                                   IsActive="{Binding IsChecking}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                       Text="{x:Static lang:Strings.CheckingNewerBuild}"
                       TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Newer build found (and active download progress while downloading it). -->
        <Border Style="{StaticResource Card.Info}"
                Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                Padding="16,12"
                Visibility="{Binding AvailableShown}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}"
                       Foreground="{x:Static theme:Accent.Brush}"
                       Text="{Binding AvailableHeading}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Body}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding AvailableBuildLine}" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Text}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding AvailableDetailLine}"
                       Visibility="{Binding AvailableDetailShown}" Margin="0,3,0,0" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Text.Muted}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding AvailableTagLine}"
                       Visibility="{Binding AvailableTagShown}" Margin="0,2,0,0" />

            <Grid Margin="0,10,0,0" Visibility="{Binding DownloadingShown}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:ProgressRing Grid.Column="0" Width="16" Height="16" RingThickness="2"
                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                     Foreground="{x:Static theme:Accent.Brush}"
                                     TrackBrush="{DynamicResource Switch.Groove}"
                                     IsActive="{Binding IsDownloading}" />
              <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                         Foreground="{DynamicResource Text}"
                         Text="{Binding DownloadProgress}"
                         TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Margin="-4,0,-4,0">
          <controls:Tile Style="{StaticResource Tile.Row}" Height="44" controls:Screen.TakesFocus="True"
                         Glyph="{x:Static theme:Glyphs.Inspect}" Label="{x:Static lang:Strings.CheckForNewerBuild}"
                         IsEnabled="{Binding CanAct}"
                         Visibility="{Binding CheckShown}"
                         Command="{Binding CheckForNewer}" />

          <controls:Tile Style="{StaticResource Tile.Row}" Height="44" controls:Screen.TakesFocus="True"
                         Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.Cancel}"
                         Visibility="{Binding CheckingShown}"
                         Command="{Binding CancelUpdate}" />

          <UniformGrid Columns="2" Visibility="{Binding ConfirmDownloadShown}">
            <controls:Tile Style="{StaticResource Tile.Row}" Height="44" controls:Screen.TakesFocus="True"
                           IsOn="True"
                           Glyph="{x:Static theme:Glyphs.Download}" Label="{x:Static lang:Strings.DownloadBuild}"
                           IsEnabled="{Binding CanAct}"
                           Command="{Binding DownloadNewer}" />
            <controls:Tile Style="{StaticResource Tile.Row}" Height="44"
                           Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.Cancel}"
                           IsEnabled="{Binding CanAct}"
                           Command="{Binding CancelUpdate}" />
          </UniformGrid>

          <controls:Tile Style="{StaticResource Tile.Row}" Height="44" controls:Screen.TakesFocus="True"
                         Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.CancelDownload}"
                         Visibility="{Binding DownloadingShown}"
                         Command="{Binding CancelUpdate}" />

          <UniformGrid Columns="2" Margin="0,2,0,0">
            <controls:Tile Style="{StaticResource Tile.Mini}" Height="40"
                           Glyph="{x:Static theme:Glyphs.Update}" Label="{Binding UpdateLabel}"
                           IsEnabled="{Binding CanAct}"
                           Command="{Binding UpdateGames}" />
            <controls:Tile Style="{StaticResource Tile.Mini}" Height="40"
                           Glyph="{x:Static theme:Glyphs.Remove}" Label="{Binding RemoveOldLabel}"
                           IsEnabled="{Binding CanAct}"
                           Command="{Binding RemoveOld}" />
          </UniformGrid>
        </StackPanel>

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.OptiPatcherHeading}"
                   Margin="4,24,0,10" />

        <!-- Tiny reminder that OptiPatcher only applies to supported games. -->
        <Border Style="{StaticResource Card.Info}"
                Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                Padding="12,8" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Text.Icon}" FontSize="13"
                       Foreground="{x:Static theme:Accent.Brush}"
                       Text="{x:Static theme:Glyphs.Info}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Text}"
                       Text="{x:Static lang:Strings.OptiPatcherSupportedOnly}"
                       TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Checking or first-time downloading OptiPatcher. -->
        <Border Style="{StaticResource Card.Info}"
                Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                Padding="16,12"
                Visibility="{Binding OptiPatcherBusyCardShown}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ProgressRing Grid.Column="0" Width="16" Height="16" RingThickness="2"
                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{x:Static theme:Accent.Brush}"
                                   TrackBrush="{DynamicResource Switch.Groove}"
                                   IsActive="{Binding IsOptiPatcherBusy}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                       Text="{Binding OptiPatcherProgress}"
                       TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Newer OptiPatcher release found (and download progress while fetching it). -->
        <Border Style="{StaticResource Card.Info}"
                Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                Padding="16,12"
                Visibility="{Binding OptiPatcherAvailableShown}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}"
                       Foreground="{x:Static theme:Accent.Brush}"
                       Text="{Binding OptiPatcherAvailableHeading}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Body}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding OptiPatcherAvailableLine}" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Text}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding OptiPatcherAvailableDetail}"
                       Visibility="{Binding OptiPatcherAvailableDetailShown}" Margin="0,3,0,0" />

            <Grid Margin="0,10,0,0" Visibility="{Binding OptiPatcherDownloadingShown}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:ProgressRing Grid.Column="0" Width="16" Height="16" RingThickness="2"
                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                     Foreground="{x:Static theme:Accent.Brush}"
                                     TrackBrush="{DynamicResource Switch.Groove}"
                                     IsActive="{Binding IsDownloadingOptiPatcher}" />
              <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                         Foreground="{DynamicResource Text}"
                         Text="{Binding OptiPatcherProgress}"
                         TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <controls:Tile x:Name="OptiPatcherActionTile" Style="{StaticResource Tile.Link}" Margin="0"
                       Tag="{Binding OptiPatcherActionGlyph}"
                       Glyph="{x:Static theme:Glyphs.Plugin}"
                       Label="{Binding OptiPatcherLabel}"
                       Detail="{Binding OptiPatcherLine}"
                       IsEnabled="{Binding CanAct}"
                       Visibility="{Binding OptiPatcherActionShown}"
                       Command="{Binding CheckOrDownloadOptiPatcher}" />

        <StackPanel Margin="-4,0,-4,0">
          <controls:Tile Style="{StaticResource Tile.Row}" controls:Screen.TakesFocus="True"
                         Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.Cancel}"
                         Visibility="{Binding OptiPatcherBusyCardShown}"
                         Command="{Binding CancelOptiPatcher}" />

          <UniformGrid Columns="2" Visibility="{Binding OptiPatcherConfirmShown}">
            <controls:Tile x:Name="OptiPatcherDownloadTile" Style="{StaticResource Tile.Row}"
                           IsOn="True"
                           Glyph="{x:Static theme:Glyphs.Download}" Label="{x:Static lang:Strings.DownloadBuild}"
                           IsEnabled="{Binding CanAct}"
                           Command="{Binding DownloadOptiPatcher}" />
            <controls:Tile Style="{StaticResource Tile.Row}"
                           Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.Cancel}"
                           IsEnabled="{Binding CanAct}"
                           Command="{Binding CancelOptiPatcher}" />
          </UniformGrid>

          <controls:Tile Style="{StaticResource Tile.Row}" controls:Screen.TakesFocus="True"
                         Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.CancelDownload}"
                         Visibility="{Binding OptiPatcherDownloadingShown}"
                         Command="{Binding CancelOptiPatcher}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{x:Static lang:Strings.OptiPatcherExplained}" Margin="6,8,6,0" />

        <StackPanel Visibility="{Binding XmxShown}">
          <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.XmxHeading}"
                     Margin="4,24,0,10" />

          <controls:Tile Style="{StaticResource Tile.Link}" Margin="0"
                         Tag="{x:Static theme:Glyphs.Add}"
                         Glyph="{x:Static theme:Glyphs.Chip}"
                         Label="{Binding XmxLabel}"
                         Detail="{Binding XmxLine}"
                         IsEnabled="{Binding CanAct}"
                         Command="{Binding AddXmx}" />

          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                     Text="{x:Static lang:Strings.XmxExplained}" Margin="6,8,6,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.ExtrasHeading}"
                   Margin="4,24,0,10" />

        <controls:Tile Style="{StaticResource Tile.Link}" Margin="0"
                       Glyph="{x:Static theme:Glyphs.Folder}"
                       Label="{x:Static lang:Strings.OpenExtras}"
                       Detail="{Binding ExtrasLine}"
                       Command="{Binding OpenExtras}" />

        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{x:Static lang:Strings.ExtrasExplained}" Margin="6,8,6,0" />

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.CompatibilityHeading}"
                   Margin="4,24,0,8" />

        <UniformGrid Columns="2" Margin="-4,0,-4,0">
          <controls:Tile Style="{StaticResource Tile.Mini}"
                         Glyph="{x:Static theme:Glyphs.Share}"
                         Label="{x:Static lang:Strings.OptiScalerCompatibility}"
                         Command="{Binding OpenOptiScalerCompatibility}" />
          <controls:Tile Style="{StaticResource Tile.Mini}"
                         Glyph="{x:Static theme:Glyphs.Share}"
                         Label="{x:Static lang:Strings.OptiPatcherCompatibility}"
                         Command="{Binding OpenOptiPatcherCompatibility}" />
        </UniformGrid>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
