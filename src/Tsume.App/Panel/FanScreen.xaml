<UserControl x:Class="Tsume.App.Panel.FanScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- The fan mode, named custom profiles, and a custom curve on a chart. Opened from Settings. -->

  <DockPanel DataContext="{Binding Settings.Fan}">

    <DockPanel DockPanel.Dock="Top" Height="46" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <WrapPanel VerticalAlignment="Center" Margin="14,0,0,0" MaxHeight="46">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.ScreenCrumb}" Text="{x:Static lang:Strings.Settings}" />
          <TextBlock Style="{StaticResource Text.ScreenCrumbSeparator}" Text="&gt;" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="{x:Static lang:Strings.Fans}" />
      </WrapPanel>
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
               Text="{x:Static lang:Strings.FanSaved}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <controls:SegmentedControl x:Name="ModeSelector" controls:Screen.TakesFocus="True"
                                   AutomationProperties.Name="{x:Static lang:Strings.Fans}"
                                   Visibility="{Binding ShowsModes, Converter={StaticResource VisibleWhenTrue}}"
                                   Segments="{Binding Modes}" SelectedIndex="{Binding ModeIndex}"
                                   DisabledIndices="{Binding Unavailable}"
                                   Reselect="{Binding ReselectMode}"
                                   IsEnabled="{Binding CanChoose}" />

        <!-- Three custom profiles, on Custom only; the chart below edits the active one. -->
        <controls:Reveal IsOpen="{Binding ShowsProfiles}">
          <Grid Margin="0,8,0,0">

            <DockPanel Visibility="{Binding IsNotRenamingProfile, Converter={StaticResource VisibleWhenTrue}}">
              <controls:Tile x:Name="RenameButton" DockPanel.Dock="Right"
                             Style="{StaticResource Tile.MiniIcon}" Width="40" Height="40" Margin="8,0,0,0"
                             Glyph="{x:Static theme:Glyphs.Edit}"
                             ToolTip="{x:Static lang:Strings.FanProfileRename}"
                             AutomationProperties.Name="{x:Static lang:Strings.FanProfileRename}"
                             Command="{Binding StartRename}" />

              <controls:SegmentedControl x:Name="ProfileSelector" Height="40"
                                         AutomationProperties.Name="{x:Static lang:Strings.FanProfiles}"
                                         Segments="{Binding Profiles}" SelectedIndex="{Binding ProfileIndex}"
                                         Reselect="{Binding ReselectProfile}" />
            </DockPanel>

            <DockPanel Visibility="{Binding IsRenamingProfile, Converter={StaticResource VisibleWhenTrue}}">
              <controls:Tile x:Name="CancelRenameButton" DockPanel.Dock="Right"
                             Style="{StaticResource Tile.MiniIcon}" Width="40" Height="40" Margin="6,0,0,0"
                             Glyph="{x:Static theme:Glyphs.Quit}"
                             ToolTip="{x:Static lang:Strings.Cancel}"
                             AutomationProperties.Name="{x:Static lang:Strings.Cancel}"
                             Command="{Binding CancelRename}" />

              <controls:Tile x:Name="ConfirmRenameButton" DockPanel.Dock="Right"
                             Style="{StaticResource Tile.MiniIcon}" Width="40" Height="40" Margin="6,0,0,0"
                             Glyph="{x:Static theme:Glyphs.Tick}"
                             ToolTip="{x:Static lang:Strings.FanProfileRenameSave}"
                             AutomationProperties.Name="{x:Static lang:Strings.FanProfileRenameSave}"
                             Command="{Binding CommitRename}" />

              <controls:Tile x:Name="TouchKeyboardButton" DockPanel.Dock="Right"
                             Style="{StaticResource Tile.MiniIcon}" Width="40" Height="40" Margin="6,0,0,0"
                             Glyph="{x:Static theme:Glyphs.Keyboard}"
                             ToolTip="{x:Static lang:Strings.Keyboard}"
                             AutomationProperties.Name="{x:Static lang:Strings.Keyboard}"
                             Click="OnTouchKeyboardClick" />

              <TextBox x:Name="ProfileNameBox" Style="{StaticResource Input.Text}"
                       Height="40" MaxLength="20"
                       AutomationProperties.Name="{x:Static lang:Strings.FanProfileRename}"
                       Text="{Binding DraftProfileName, UpdateSourceTrigger=PropertyChanged}"
                       PreviewKeyDown="OnProfileNameKeyDown" />
            </DockPanel>

          </Grid>
        </controls:Reveal>

        <!-- Editable on Custom; on Auto it shows the machine's own curve, on Max full speed. -->
        <controls:FanCurveEditor x:Name="CurveEditor" Margin="0,10,0,0"
                                 AutomationProperties.Name="{x:Static lang:Strings.FanCurve}"
                                 Visibility="{Binding CurveShown, Converter={StaticResource VisibleWhenTrue}}"
                                 Limits="{Binding Limits}"
                                 Temperatures="{Binding Temperatures}"
                                 Stock="{Binding Stock}"
                                 Speeds="{Binding Speeds}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 IsEditing="{Binding IsEditing}"
                                 IsDragging="{Binding IsDragging}"
                                 CurrentCelsius="{Binding CpuCelsius}"
                                 CurrentRpm="{Binding FanRpm}"
                                 CurrentSpeed="{Binding FanSpeed}"
                                 WarnCelsius="{Binding WarnCelsius}"
                                 HotCelsius="{Binding HotCelsius}" />

        <TextBlock Style="{StaticResource Text.Caption}" Margin="4,8,4,0"
                   Text="{Binding DeviceName}"
                   Visibility="{Binding CurveShown, Converter={StaticResource VisibleWhenTrue}}" />

        <TextBlock Style="{StaticResource Text.Caption}" Margin="4,8,0,0"
                   TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding Note}"
                   Visibility="{Binding ShowsNote, Converter={StaticResource VisibleWhenTrue}}" />

        <controls:Tile x:Name="ResetTile" Style="{StaticResource Tile.Row}" Margin="0,14,0,8"
                       Glyph="{x:Static theme:Glyphs.Update}"
                       Label="{x:Static lang:Strings.FanReset}"
                       Command="{Binding Reset}"
                       IsEnabled="{Binding CanReset}"
                       Visibility="{Binding CurveShown, Converter={StaticResource VisibleWhenTrue}}" />

        <!-- Why part of the chart cannot be reached: the helper keeps the fans above a floor when hot. -->
        <Border Style="{StaticResource Card.Info}"
                Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                Visibility="{Binding ShowsFloorHint, Converter={StaticResource VisibleWhenTrue}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="14"
                       Foreground="{x:Static theme:Accent.Brush}" VerticalAlignment="Center" Margin="0,0,10,0"
                       Text="{x:Static theme:Glyphs.Info}" />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                       TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                       Text="{x:Static lang:Strings.FanFloorHint}" />
          </DockPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
