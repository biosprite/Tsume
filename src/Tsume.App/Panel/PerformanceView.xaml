<UserControl x:Class="Tsume.App.Panel.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <UserControl.Resources>

    <!-- One reading: the figure, then its name in smaller type. -->
    <Style x:Key="Reading" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Reading.Name" TargetType="Run">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>

    <Style x:Key="Reading.Divider" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,2,0,1" />
      <Setter Property="Background" Value="{DynamicResource Surface.Divider}" />
    </Style>

  </UserControl.Resources>

  <StackPanel DataContext="{Binding Performance}">

    <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.PerformanceHeading}" />

    <controls:SegmentedControl Segments="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" />

    <!-- Only Manual mode shows these. -->
    <controls:Reveal IsOpen="{Binding ShowsLimitSliders}">
      <StackPanel Margin="0,8,0,0">

        <controls:LevelSlider Glyph="{x:Static theme:Glyphs.Sustained}" Label="{x:Static lang:Strings.Sustained}" Unit=" W"
                              Minimum="{Binding MinWatts}"
                              Maximum="{Binding MaxSustainedWatts}"
                              LargeChange="1"
                              Value="{Binding Sustained}" />

        <controls:LevelSlider Glyph="{x:Static theme:Glyphs.Boost}" Label="{x:Static lang:Strings.Boost}" Unit=" W"
                              Minimum="{Binding MinBoostWatts}"
                              Maximum="{Binding MaxBoostWatts}"
                              LargeChange="1"
                              Value="{Binding Boost}"
                              Margin="0,8,0,0" />
      </StackPanel>
    </controls:Reveal>

    <!-- Read-only: the limits in force, then the live readings or a note that there are none.
         The outer columns are wider because their labels are the longest. -->
    <Border Margin="0,8,0,0" Padding="0,5,0,6" IsHitTestVisible="False"
            Background="{DynamicResource Surface}" CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="0.9*" />
          <ColumnDefinition Width="0.9*" />
          <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource Reading}">
          <Run Text="{Binding SustainedInForce, Mode=OneWay}" />
          <Run Style="{StaticResource Reading.Name}" Text="{x:Static lang:Strings.Sustained}" />
        </TextBlock>

        <TextBlock Grid.Column="1" Style="{StaticResource Reading}">
          <Run Text="{Binding BoostInForce, Mode=OneWay}" />
          <Run Style="{StaticResource Reading.Name}" Text="{x:Static lang:Strings.Boost}" />
        </TextBlock>

        <TextBlock Grid.Column="2" Style="{StaticResource Reading}"
                   Visibility="{Binding IsHelperOnline, Converter={StaticResource VisibleWhenTrue}}">
          <Run Text="{Binding CpuReading, Mode=OneWay}" />
          <Run Style="{StaticResource Reading.Name}" Text="{x:Static lang:Strings.Cpu}" />
        </TextBlock>

        <TextBlock Grid.Column="3" Style="{StaticResource Reading}"
                   Visibility="{Binding IsHelperOnline, Converter={StaticResource VisibleWhenTrue}}">
          <Run Text="{Binding FanReading, Mode=OneWay}" />
          <Run Style="{StaticResource Reading.Name}" Text="{x:Static lang:Strings.Fan}" />
        </TextBlock>

        <!-- Without the helper there are no live readings; this note takes their place. -->
        <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Text.Caption}"
                   FontSize="10.5" LineHeight="12" LineStackingStrategy="BlockLineHeight"
                   Margin="8,0" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding HelperNote}"
                   Visibility="{Binding IsHelperOffline, Converter={StaticResource VisibleWhenTrue}}" />

        <Border Grid.Column="1" Style="{StaticResource Reading.Divider}" />
        <Border Grid.Column="2" Style="{StaticResource Reading.Divider}" />
        <Border Grid.Column="3" Style="{StaticResource Reading.Divider}"
                Visibility="{Binding IsHelperOnline, Converter={StaticResource VisibleWhenTrue}}" />
      </Grid>
    </Border>

  </StackPanel>

</UserControl>
