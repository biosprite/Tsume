<UserControl x:Class="Tsume.App.Panel.UpscalerProxyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- Dropdown for what proxy DLL name OptiScaler installs as; greyed out once installed or locked. -->
  <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}"
          Padding="16,14,16,14" Margin="0">
    <StackPanel>
      <DockPanel Margin="0,0,0,10">
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsProxyEditable}" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>

        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="20" Width="22"
                   TextAlignment="Center" VerticalAlignment="Center"
                   Text="{x:Static theme:Glyphs.Proxy}" />

        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static lang:Strings.InstallAs}" />
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                     Text="{Binding ProxyDetail}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <controls:KeyDropdown ItemsSource="{Binding ProxyOptions}"
                            SelectedItem="{Binding SelectedProxyOption, Mode=TwoWay}"
                            IsEnabled="{Binding IsProxyEditable}"
                            AutomationProperties.Name="{x:Static lang:Strings.InstallAs}">
        <controls:KeyDropdown.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" FontSize="11"
                         Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                         Margin="8,0,0,0" Text="{Binding Hint}" />
              <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                         Text="{Binding Label}" />
            </DockPanel>
          </DataTemplate>
        </controls:KeyDropdown.ItemTemplate>
      </controls:KeyDropdown>
    </StackPanel>
  </Border>

</UserControl>
