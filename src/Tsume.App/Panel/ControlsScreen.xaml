<UserControl x:Class="Tsume.App.Panel.ControlsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- Panel side, Quick tiles, Dedicated Actions, and System Buttons. Opened from Settings. -->

  <UserControl.Resources>
    <DataTemplate x:Key="SummaryChipTemplate">
      <Grid Margin="0,0,5,4">
        <Border Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                BorderThickness="1" CornerRadius="4" Padding="6,2"
                Visibility="{Binding AccentShown}">
          <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5" FontWeight="SemiBold"
                     Foreground="{x:Static theme:Accent.Brush}"
                     Text="{Binding Text}" VerticalAlignment="Center" />
        </Border>

        <Border Background="{DynamicResource Surface.Hover}"
                BorderBrush="{DynamicResource Surface.Divider}"
                BorderThickness="1" CornerRadius="4" Padding="6,2"
                Visibility="{Binding NeutralShown}">
          <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5"
                     Foreground="{DynamicResource Text.Muted}"
                     Text="{Binding Text}" VerticalAlignment="Center" />
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel DataContext="{Binding Settings.Controls}">

    <DockPanel DockPanel.Dock="Top" Height="46" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <WrapPanel VerticalAlignment="Center" Margin="14,0,0,0" MaxHeight="46">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.ScreenCrumb}" Text="{x:Static lang:Strings.Settings}" />
          <TextBlock Style="{StaticResource Text.ScreenCrumbSeparator}" Text="&gt;" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="{x:Static lang:Strings.ControlsAndLayout}" />
      </WrapPanel>
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
               Text="{Binding Status}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <!-- Panel side & reopen behavior -->
        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.PanelPositionHeading}" />

        <controls:Tile Style="{StaticResource Tile.Switch}" controls:Screen.TakesFocus="True"
                       Glyph="{x:Static theme:Glyphs.DockRight}"
                       Label="{x:Static lang:Strings.OpenOnRight}"
                       Detail="{x:Static lang:Strings.OpenOnRightDetail}"
                       IsOn="{Binding OpenOnRight}"
                       Command="{Binding ToggleOpenOnRight}" />

        <controls:Tile Style="{StaticResource Tile.Switch}"
                       Glyph="{x:Static theme:Glyphs.History}"
                       Label="{x:Static lang:Strings.RememberLastPage}"
                       Detail="{x:Static lang:Strings.RememberLastPageDetail}"
                       IsOn="{Binding RememberLastPage}"
                       Command="{Binding ToggleRememberLastPage}" />

        <!-- Main screen quick tiles (live preview grid, reordering, and column density) -->
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.MainTilesHeading}"
                     Margin="4,16,0,10" />

          <controls:Tile Style="{StaticResource Tile.GameLink}"
                         Glyph="{x:Static theme:Glyphs.Tiles}"
                         Label="{x:Static lang:Strings.MainTilesTitle}"
                         AutomationProperties.HelpText="{Binding MainTilesPage.SummaryDetail}"
                         IsOn="{Binding MainTilesPage.IsCustomized}"
                         Command="{Binding MainTilesPage.Open}">
            <ItemsControl ItemsSource="{Binding MainTilesPage.SummaryChips}"
                          ItemTemplate="{StaticResource SummaryChipTemplate}"
                          Focusable="False" Margin="0,0,0,-4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </controls:Tile>
        </StackPanel>

        <!-- Dedicated actions (opens a categorized, compact shortcuts screen) -->
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.DedicatedActionsHeading}"
                     Margin="4,16,0,10" />

          <controls:Tile Style="{StaticResource Tile.GameLink}"
                         Glyph="{x:Static theme:Glyphs.Keyboard}"
                         Label="{x:Static lang:Strings.DedicatedActionsTitle}"
                         AutomationProperties.HelpText="{Binding DedicatedActionsPage.SummaryDetail}"
                         IsOn="{Binding DedicatedActionsPage.HasActiveBindings}"
                         Command="{Binding DedicatedActionsPage.Open}">
            <ItemsControl ItemsSource="{Binding DedicatedActionsPage.SummaryChips}"
                          ItemTemplate="{StaticResource SummaryChipTemplate}"
                          Focusable="False" Margin="0,0,0,-4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </controls:Tile>
        </StackPanel>

        <!-- System buttons (hardware buttons + rear back paddles in one screen) -->
        <StackPanel Visibility="{Binding SystemButtonsPage.SectionVisibility}">
          <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.SystemButtonsHeading}"
                     Margin="4,16,0,10" />

          <controls:Tile Style="{StaticResource Tile.Link}"
                         Glyph="{x:Static theme:Glyphs.Buttons}"
                         Label="{x:Static lang:Strings.SystemButtonsTitle}"
                         Detail="{Binding SystemButtonsPage.SummaryDetail}"
                         Command="{Binding SystemButtonsPage.Open}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
