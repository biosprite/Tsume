<UserControl x:Class="Tsume.App.Panel.ControlsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- Panel side, Dedicated Actions, and System Buttons. Opened from Settings. -->

  <DockPanel DataContext="{Binding Settings.Controls}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.ControlsAndLayout}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
               Text="{Binding Status}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <!-- Panel side -->
        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.PanelPositionHeading}" />

        <controls:Tile Style="{StaticResource Tile.Switch}" controls:Screen.TakesFocus="True"
                       Glyph="{x:Static theme:Glyphs.DockRight}"
                       Label="{x:Static lang:Strings.OpenOnRight}"
                       Detail="{x:Static lang:Strings.OpenOnRightDetail}"
                       IsOn="{Binding OpenOnRight}"
                       Command="{Binding ToggleOpenOnRight}" />

        <!-- Dedicated actions (opens a categorized, compact shortcuts screen) -->
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.DedicatedActionsHeading}"
                     Margin="4,16,0,10" />

          <controls:Tile Style="{StaticResource Tile.Link}"
                         Glyph="{x:Static theme:Glyphs.Keyboard}"
                         Label="{x:Static lang:Strings.DedicatedActionsTitle}"
                         Detail="{Binding DedicatedActionsPage.SummaryDetail}"
                         IsOn="{Binding DedicatedActionsPage.HasActiveBindings}"
                         Command="{Binding DedicatedActionsPage.Open}" />
        </StackPanel>

        <!-- System buttons (hardware buttons + rear back paddles in one screen) -->
        <StackPanel Visibility="{Binding SystemButtonsPage.SectionVisibility}">
          <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.SystemButtonsHeading}"
                     Margin="4,16,0,10" />

          <controls:Tile Style="{StaticResource Tile.Link}"
                         Glyph="{x:Static theme:Glyphs.Buttons}"
                         Label="{x:Static lang:Strings.SystemButtonsTitle}"
                         Detail="{Binding SystemButtonsPage.SummaryDetail}"
                         Command="{Binding SystemButtonsPage.Open}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
