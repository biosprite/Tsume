<UserControl x:Class="Tsume.App.Panel.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:panel="clr-namespace:Tsume.App.Panel"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             Focusable="False">

  <DockPanel DataContext="{Binding Status}" Margin="4,0">

    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,5,0"
                   Foreground="{StaticResource Signal.Good}"
                   Text="{x:Static theme:Glyphs.Charging}"
                   Visibility="{Binding IsPluggedIn, Converter={StaticResource VisibleWhenTrue}}" />

        <TextBlock Style="{StaticResource Text.Body}" FontSize="16" VerticalAlignment="Center"
                   Text="{Binding BatteryPercent, StringFormat={}{0}%}" />

        <controls:BatteryGauge Margin="9,1,0,0" VerticalAlignment="Center"
                               Percent="{Binding BatteryPercent}"
                               IsCharging="{Binding IsPluggedIn}"
                               IsLow="{Binding IsBatteryLow}" />
      </StackPanel>

      <!-- Which build this is, kept faint; level with the date on the other side. -->
      <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,7,0,0" Opacity="0.6"
                 Text="{x:Static panel:HeaderView.Version}" />
    </StackPanel>

    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Text.Display}" Text="{Binding Time}" />
        <!-- AM/PM; empty on a 24-hour clock. -->
        <TextBlock Style="{StaticResource Text.Body}" FontSize="15" Foreground="{DynamicResource Text.Muted}"
                   VerticalAlignment="Bottom" Margin="5,0,0,7"
                   Text="{Binding Meridiem}" />
      </StackPanel>
      <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Date}" Margin="1,-2,0,0" />
    </StackPanel>

  </DockPanel>

</UserControl>
