<UserControl x:Class="Tsume.App.Panel.UpscalingGameScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             xmlns:panel="clr-namespace:Tsume.App.Panel"
             Focusable="False">

  <!-- OptiScaler in one game: its state, the actions, and its settings. -->

  <DockPanel DataContext="{Binding Upscaling.Game}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Name}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
               Text="{Binding Status}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <Border Style="{StaticResource Card.Note}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding StateLine}" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding FoundLine}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Faint}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding FolderLine}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Note}" Visibility="{Binding NoticeShown}">
          <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                     TextWrapping="Wrap" TextTrimming="None" Text="{Binding Notice}" />
        </Border>

        <Border Style="{StaticResource Card.Note}" Visibility="{Binding CautionShown}">
          <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                     TextWrapping="Wrap" TextTrimming="None" Text="{x:Static lang:Strings.OnlineGameCaution}" />
        </Border>

        <!-- The first button is always the next sensible action. -->
        <StackPanel Margin="-4,0,-4,0">
          <controls:Tile Style="{StaticResource Tile.Row}" controls:Screen.TakesFocus="True"
                         Glyph="{Binding PrimaryGlyph}" Label="{Binding PrimaryLabel}"
                         Visibility="{Binding PrimaryShown}"
                         Command="{Binding Primary}" />

          <controls:Tile Style="{StaticResource Tile.Row}"
                         Glyph="{x:Static theme:Glyphs.Remove}" Label="{x:Static lang:Strings.RemoveOptiScaler}"
                         Visibility="{Binding RemoveShown}"
                         Command="{Binding Remove}" />

          <controls:Tile Style="{StaticResource Tile.Row}"
                         Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.TakeOffList}"
                         Visibility="{Binding TakeOffListShown}"
                         Command="{Binding TakeOffList}" />
        </StackPanel>

        <panel:UpscalerTuningView DataContext="{Binding Tuning}" Margin="0,20,0,0"
                                  Visibility="{Binding DataContext.TuningShown, RelativeSource={RelativeSource AncestorType=DockPanel}}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
