<UserControl x:Class="Tsume.App.Panel.UpscalingGameScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             xmlns:panel="clr-namespace:Tsume.App.Panel"
             Focusable="False">

  <!-- OptiScaler in one game: its state, its settings, and install/update/remove actions. -->

  <DockPanel DataContext="{Binding Upscaling.Game}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Name}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
               Text="{Binding Status}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <Border Style="{StaticResource Card.Note}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding StateLine}" />
            <Border Background="{x:Static theme:Accent.Tint}"
                    BorderBrush="{x:Static theme:Accent.Wash}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="7,2" Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Visibility="{Binding OptiPatcherBadgeShown}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="12"
                           Foreground="{x:Static theme:Accent.Brush}"
                           Text="{x:Static theme:Glyphs.Plugin}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                           Foreground="{x:Static theme:Accent.Brush}"
                           Text="{Binding OptiPatcherBadge}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding FoundUpscalers}" Focusable="False"
                          AutomationProperties.Name="{Binding FoundLine}"
                          Margin="0,8,0,-4"
                          Visibility="{Binding FoundUpscalersShown}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Surface.Hover}"
                          BorderBrush="{DynamicResource Surface.Divider}"
                          BorderThickness="1" CornerRadius="4" Padding="6,2"
                          Margin="0,0,5,4">
                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding}" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                       Text="{x:Static lang:Strings.FoundNoUpscalers}" Margin="0,6,0,0"
                       Visibility="{Binding FoundNoUpscalersShown}" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:Tile Grid.Column="0" Style="{StaticResource Tile.Icon}"
                             Width="36" Height="36"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Glyph="{x:Static theme:Glyphs.Folder}"
                             AutomationProperties.Name="{x:Static lang:Strings.OpenGameFolder}"
                             IsEnabled="{Binding CanOpenFolder}"
                             Command="{Binding OpenFolder}" />
              <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                         Foreground="{DynamicResource Text.Faint}"
                         TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                         Text="{Binding FolderLine}" Margin="10,0,0,0"
                         Visibility="{Binding FolderLineShown}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Note}" Visibility="{Binding NoticeShown}">
          <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                     TextWrapping="Wrap" TextTrimming="None" Text="{Binding Notice}" />
        </Border>

        <Border Style="{StaticResource Card.Info}"
                Background="{x:Static theme:Accent.Tint}"
                BorderBrush="{x:Static theme:Accent.Wash}"
                Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding CautionShown}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Text.Icon}" FontSize="13"
                       Foreground="{x:Static theme:Accent.Brush}"
                       Text="{x:Static theme:Glyphs.Info}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Text}"
                       Text="{x:Static lang:Strings.OnlineGameCaution}"
                       TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Install-time proxy choice and install/update/remove actions sit above the tuning options. -->
        <panel:UpscalerProxyCard DataContext="{Binding Tuning}" Margin="0,0,0,8"
                                 IsEnabled="{Binding DataContext.CanTune, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                 Visibility="{Binding DataContext.TuningShown, RelativeSource={RelativeSource AncestorType=DockPanel}}" />

        <StackPanel Margin="-4,0,-4,0">
          <controls:Tile Style="{StaticResource Tile.Row}" controls:Screen.TakesFocus="True"
                         Glyph="{Binding PrimaryGlyph}" Label="{Binding PrimaryLabel}"
                         Visibility="{Binding PrimaryShown}"
                         IsEnabled="{Binding CanAct}"
                         Command="{Binding Primary}" />

          <controls:Tile Style="{StaticResource Tile.Row}"
                         Glyph="{x:Static theme:Glyphs.Remove}" Label="{x:Static lang:Strings.RemoveOptiScaler}"
                         Visibility="{Binding RemoveShown}"
                         IsEnabled="{Binding CanAct}"
                         Command="{Binding Remove}" />

          <controls:Tile Style="{StaticResource Tile.Row}"
                         Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.TakeOffList}"
                         Visibility="{Binding TakeOffListShown}"
                         IsEnabled="{Binding CanAct}"
                         Command="{Binding TakeOffList}" />
        </StackPanel>

        <panel:UpscalerTuningView DataContext="{Binding Tuning}" Margin="0,20,0,0"
                                  IsEnabled="{Binding DataContext.CanTune, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                  Visibility="{Binding DataContext.TuningShown, RelativeSource={RelativeSource AncestorType=DockPanel}}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
