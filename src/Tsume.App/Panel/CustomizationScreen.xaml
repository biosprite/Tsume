<UserControl x:Class="Tsume.App.Panel.CustomizationScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- Tsume's own colours: presets, then accent, background and text. Opened from Settings. -->

  <DockPanel DataContext="{Binding Settings.Customization}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.Customization}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
               Text="{x:Static lang:Strings.CustomizationSaved}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.PresetsHeading}" />

        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False" Margin="-4"
                      controls:Screen.TakesFocus="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:Tile Style="{StaticResource Tile.Preset}"
                             Label="{Binding Name}"
                             Background="{Binding Background}"
                             BorderBrush="{Binding Accent}"
                             Foreground="{Binding Text}"
                             IsOn="{Binding IsCurrent}"
                             Command="{Binding Choose}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Per colour: a swatch picker for the tint and a slider for brightness. -->
        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.ColoursHeading}"
                   Margin="4,24,0,10" />

        <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,18">
                <controls:SwatchPicker Label="{Binding Name}"
                                       AutomationProperties.Name="{Binding Name}"
                                       Colours="{Binding Swatches}" SelectedColour="{Binding Tint}" />

                <controls:LevelSlider Glyph="{x:Static theme:Glyphs.Brightness}"
                                      Label="{x:Static lang:Strings.LightBrightness}" Unit="%"
                                      AutomationProperties.Name="{Binding BrightnessName}"
                                      Minimum="{Binding Dimmest}" Maximum="100" LargeChange="1"
                                      Value="{Binding Brightness}"
                                      Margin="0,6,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
