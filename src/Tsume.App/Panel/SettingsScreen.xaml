<UserControl x:Class="Tsume.App.Panel.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <DockPanel>

    <DockPanel DockPanel.Dock="Top" Height="46" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Settings.Close}" />

      <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="{x:Static lang:Strings.Settings}"
                 Margin="14,0,0,0" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <Border Height="1" Background="{DynamicResource Surface.Divider}" Margin="6,12,6,12" />

      <controls:Tile Style="{StaticResource Tile.Row}" Margin="0"
                     Glyph="{x:Static theme:Glyphs.Quit}" Label="{x:Static lang:Strings.QuitTsume}"
                     Command="{Binding Quit.Open}" />
    </StackPanel>

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel DataContext="{Binding Settings}">

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.GeneralHeading}" />

        <controls:Tile Style="{StaticResource Tile.Switch}" controls:Screen.TakesFocus="True"
                       Glyph="{x:Static theme:Glyphs.Startup}"
                       Label="{x:Static lang:Strings.StartWithWindows}"
                       Detail="{x:Static lang:Strings.StartWithWindowsDetail}"
                       IsOn="{Binding StartsWithWindows}"
                       Command="{Binding ToggleStartWithWindows}" />

        <controls:Tile Style="{StaticResource Tile.Switch}"
                       Glyph="{x:Static theme:Glyphs.StartMenu}"
                       Label="{x:Static lang:Strings.ShowInStartMenu}"
                       Detail="{x:Static lang:Strings.ShowInStartMenuDetail}"
                       Visibility="{Binding StartMenuSwitch}"
                       IsOn="{Binding IsInStartMenu}"
                       Command="{Binding ToggleStartMenu}" />

        <!-- Charge limit: a card with its choices inside, not a switch. -->
        <StackPanel DataContext="{Binding ChargeLimit}" Visibility="{Binding Card}">

          <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}"
                  Padding="18,10,16,10" Margin="0,0,0,8">
            <StackPanel>

              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="20" Width="22"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Text="{x:Static theme:Glyphs.Battery}" />

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static lang:Strings.ChargeLimit}" />
                  <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                             Text="{Binding Detail}" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>

              <controls:SegmentedControl Margin="0,8,0,0" Height="34"
                                         AutomationProperties.Name="{x:Static lang:Strings.ChargeLimit}"
                                         Segments="{Binding Segments}" SelectedIndex="{Binding Index}"
                                         IsEnabled="{Binding IsAvailable}" />
            </StackPanel>
          </Border>

          <!-- Compact info banner explaining why a plugged-in battery rests until 10% below the limit. -->
          <controls:Reveal IsOpen="{Binding ShowRestingHint}">
            <Border Style="{StaticResource Card.Info}"
                    Background="{x:Static theme:Accent.Tint}"
                    BorderBrush="{x:Static theme:Accent.Wash}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="14"
                           Foreground="{x:Static theme:Accent.Brush}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="{x:Static theme:Glyphs.Info}" />
                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                           TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                           Text="{Binding RestingHint}" />
              </DockPanel>
            </Border>
          </controls:Reveal>

        </StackPanel>

        <controls:Tile Style="{StaticResource Tile.Switch}"
                       Glyph="{x:Static theme:Glyphs.Pause}"
                       Label="{Binding OemPauseLabel}"
                       Detail="{Binding MsiCenterDetail}"
                       IsOn="{Binding IsMsiCenterPaused}"
                       Command="{Binding ToggleMsiCenter}" />

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.CustomizationHeading}"
                   Margin="4,12,0,10" />

        <!-- Hidden on a machine whose power limits cannot be set. -->
        <controls:Tile Style="{StaticResource Tile.Link}"
                       Visibility="{Binding PerformancePresets.Card}"
                       Glyph="{x:Static theme:Glyphs.Sustained}"
                       Label="{x:Static lang:Strings.PerformancePresets}"
                       Detail="{x:Static lang:Strings.PerformancePresetsDetail}"
                       Command="{Binding PerformancePresets.Open}" />

        <!-- Hidden on a machine whose fans cannot be controlled. -->
        <controls:Tile Style="{StaticResource Tile.Link}"
                       Visibility="{Binding Fan.Card}"
                       Glyph="{x:Static theme:Glyphs.Fan}"
                       Label="{x:Static lang:Strings.Fans}"
                       Detail="{x:Static lang:Strings.FansSettingsDetail}"
                       Command="{Binding Fan.Open}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Customize}"
                       Label="{x:Static lang:Strings.Customization}"
                       Detail="{x:Static lang:Strings.CustomizationDetail}"
                       Command="{Binding Customization.Open}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Gamepad}"
                       Label="{x:Static lang:Strings.ControlsAndLayout}"
                       Detail="{x:Static lang:Strings.ControlsAndLayoutDetail}"
                       Command="{Binding Controls.Open}" />

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.TroubleshootingHeading}"
                   Margin="4,12,0,10" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Share}"
                       Label="{x:Static lang:Strings.ShareLogs}"
                       Detail="{Binding ShareLogsDetail}"
                       Command="{Binding ShareLogs}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Folder}"
                       Label="{x:Static lang:Strings.OpenDataFolder}"
                       Detail="{x:Static lang:Strings.OpenDataFolderDetail}"
                       Command="{Binding OpenDataFolder}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Developer}"
                       Label="{x:Static lang:Strings.DeveloperOptions}"
                       Detail="{x:Static lang:Strings.DeveloperOptionsDetail}"
                       Command="{Binding Developer.Open}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
