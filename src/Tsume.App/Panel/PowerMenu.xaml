<UserControl x:Class="Tsume.App.Panel.PowerMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <StackPanel DataContext="{Binding Power}">

    <controls:Tile Style="{StaticResource Tile.Row}"
                   Glyph="{x:Static theme:Glyphs.Sleep}" Label="{x:Static lang:Strings.Hibernate}"
                   Command="{Binding Hibernate}" />

    <controls:Tile Style="{StaticResource Tile.Row}"
                   Glyph="{x:Static theme:Glyphs.Lock}" Label="{x:Static lang:Strings.Lock}"
                   Command="{Binding Lock}" />

    <controls:Tile Style="{StaticResource Tile.Row}"
                   Glyph="{x:Static theme:Glyphs.Restart}" Label="{x:Static lang:Strings.Restart}"
                   Command="{Binding Restart}" />

    <controls:Tile Style="{StaticResource Tile.Row}"
                   Glyph="{x:Static theme:Glyphs.Power}" Label="{x:Static lang:Strings.ShutDown}"
                   Command="{Binding ShutDown}" />

    <Border Height="1" Background="{DynamicResource Surface.Divider}" Margin="10,8" />

    <controls:Tile Style="{StaticResource Tile.Row}" Height="46"
                   Glyph="{x:Static theme:Glyphs.Back}" Label="{x:Static lang:Strings.Back}"
                   Command="{Binding Close}" />
  </StackPanel>

</UserControl>
