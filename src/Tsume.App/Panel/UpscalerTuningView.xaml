<UserControl x:Class="Tsume.App.Panel.UpscalerTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- The OptiScaler settings Tsume manages. Used on each game's page and the defaults page;
       its DataContext is an UpscalerTuningViewModel. -->

  <StackPanel>

    <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.UpscalerHeading}" />

    <controls:SegmentedControl controls:Screen.TakesFocus="True"
                               AutomationProperties.Name="{x:Static lang:Strings.UpscalerHeading}"
                               Segments="{Binding Upscalers}" SelectedIndex="{Binding UpscalerIndex}" />

    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
               Text="{Binding UpscalerDetail}" Margin="6,6,6,0" />

    <controls:Reveal IsOpen="{Binding ShowsModel}">
      <StackPanel>
        <controls:SegmentedControl AutomationProperties.Name="FSR 4" Margin="0,10,0,0"
                                   Segments="{Binding Models}" SelectedIndex="{Binding ModelIndex}" />

        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding ModelDetail}" Margin="6,6,6,0" />
      </StackPanel>
    </controls:Reveal>

    <controls:Reveal IsOpen="{Binding ShowsXmxModel}">
      <StackPanel>
        <controls:SegmentedControl AutomationProperties.Name="FSR 4 XMX" Margin="0,10,0,0"
                                   Segments="{Binding XmxModels}" SelectedIndex="{Binding ModelIndex}" />

        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding XmxModelDetail}" Margin="6,6,6,0" />
      </StackPanel>
    </controls:Reveal>

    <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.FrameGenHeading}"
               Margin="4,24,0,10" />

    <controls:SegmentedControl AutomationProperties.Name="{x:Static lang:Strings.FrameGenHeading}"
                               Segments="{Binding FrameGens}" SelectedIndex="{Binding FrameGenIndex}" />

    <controls:Reveal IsOpen="{Binding ShowsSource}">
      <StackPanel>
        <controls:SegmentedControl Margin="0,8,0,0"
                                   Segments="{Binding Sources}" SelectedIndex="{Binding SourceIndex}" />

        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding SourceDetail}" Margin="6,6,6,0" />
      </StackPanel>
    </controls:Reveal>

    <controls:Reveal IsOpen="{Binding ShowsMultiplier}">
      <controls:SegmentedControl Margin="0,10,0,0"
                                 Segments="{Binding Multipliers}" SelectedIndex="{Binding MultiplierIndex}" />
    </controls:Reveal>

    <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.InGameHeading}"
               Margin="4,24,0,10" />

    <controls:Tile Style="{StaticResource Tile.Switch}"
                   Glyph="{x:Static theme:Glyphs.Chip}"
                   Label="{x:Static lang:Strings.SpoofNvidia}"
                   Detail="{x:Static lang:Strings.SpoofNvidiaDetail}"
                   IsOn="{Binding SpoofNvidia}"
                   Command="{Binding ToggleSpoof}" />

    <controls:Tile Style="{StaticResource Tile.Switch}" Margin="0"
                   Glyph="{x:Static theme:Glyphs.Counter}"
                   Label="{x:Static lang:Strings.ShowFps}"
                   Detail="{x:Static lang:Strings.ShowFpsDetail}"
                   IsOn="{Binding ShowFps}"
                   Command="{Binding ToggleFps}" />

    <!-- Shown only until OptiScaler is installed in the game; after that the file name is fixed. -->
    <controls:Reveal IsOpen="{Binding ShowsProxy}">
      <controls:Tile Style="{StaticResource Tile.Link}" Margin="0,8,0,0"
                     Tag="{x:Static theme:Glyphs.Proxy}"
                     Glyph="{x:Static theme:Glyphs.Proxy}"
                     Label="{Binding ProxyLabel}"
                     Detail="{x:Static lang:Strings.LoadsAsDetail}"
                     Command="{Binding NextProxy}" />
    </controls:Reveal>

  </StackPanel>

</UserControl>
