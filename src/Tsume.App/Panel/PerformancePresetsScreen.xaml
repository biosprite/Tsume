<UserControl x:Class="Tsume.App.Panel.PerformancePresetsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- The watts behind each performance mode, with a reset to the device's own values.
       Opened from Settings. -->

  <DockPanel DataContext="{Binding Settings.PerformancePresets}">

    <DockPanel DockPanel.Dock="Top" Height="46" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <WrapPanel VerticalAlignment="Center" Margin="14,0,0,0" MaxHeight="46">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.ScreenCrumb}" Text="{x:Static lang:Strings.Settings}" />
          <TextBlock Style="{StaticResource Text.ScreenCrumbSeparator}" Text="&gt;" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="{x:Static lang:Strings.PerformancePresets}" />
      </WrapPanel>
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
               Text="{x:Static lang:Strings.PerformancePresetsSaved}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False"
                      controls:Screen.TakesFocus="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,22">

                <!-- The mode's name, plus the device's stock figures once the sliders differ from them. -->
                <DockPanel Margin="0,0,4,0">
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" FontSize="11"
                             Text="{Binding StockLine}" Visibility="{Binding StockNote}" />
                  <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding Heading}" />
                </DockPanel>

                <controls:LevelSlider Glyph="{x:Static theme:Glyphs.Sustained}"
                                      Label="{x:Static lang:Strings.Sustained}" Unit=" W"
                                      AutomationProperties.Name="{Binding SustainedName}"
                                      Minimum="{Binding MinWatts}" Maximum="{Binding MaxSustainedWatts}"
                                      LargeChange="1"
                                      Value="{Binding Sustained}" />

                <controls:LevelSlider Glyph="{x:Static theme:Glyphs.Boost}"
                                      Label="{x:Static lang:Strings.Boost}" Unit=" W"
                                      AutomationProperties.Name="{Binding BoostName}"
                                      Minimum="{Binding MinBoostWatts}" Maximum="{Binding MaxBoostWatts}"
                                      LargeChange="1"
                                      Value="{Binding Boost}"
                                      Margin="0,8,0,0" />

                <controls:LevelSlider Glyph="{x:Static theme:Glyphs.Boost}"
                                      Label="{x:Static lang:Strings.FastBoost}" Unit=" W"
                                      AutomationProperties.Name="{Binding FastBoostName}"
                                      Minimum="{Binding MinFastBoostWatts}" Maximum="{Binding MaxFastBoostWatts}"
                                      LargeChange="1"
                                      Value="{Binding FastBoost}"
                                      Margin="0,8,0,0"
                                      Visibility="{Binding HasFastBoost, Converter={StaticResource VisibleWhenTrue}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:Tile Style="{StaticResource Tile.Row}" Margin="0"
                       Glyph="{x:Static theme:Glyphs.Update}"
                       Label="{x:Static lang:Strings.PresetsReset}"
                       Command="{Binding Reset}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
