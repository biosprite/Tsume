<UserControl x:Class="Tsume.App.Panel.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             Focusable="False">

  <ItemsControl ItemsSource="{Binding Actions.VisibleTiles}" Focusable="False" Margin="-4">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Columns="{Binding Actions.Columns}" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <controls:Tile Glyph="{Binding Glyph}"
                       Label="{Binding Label}"
                       Detail="{Binding Detail}"
                       IsOn="{Binding IsOn}"
                       Command="{Binding Command}" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

</UserControl>
