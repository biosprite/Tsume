<UserControl x:Class="Tsume.App.Panel.DeveloperScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <DockPanel DataContext="{Binding Settings.Developer}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.DeveloperOptions}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.DeveloperDiscoveryHeading}" />

        <controls:Tile Style="{StaticResource Tile.Link}" controls:Screen.TakesFocus="True"
                       Glyph="{x:Static theme:Glyphs.Inspect}"
                       Label="{x:Static lang:Strings.OpenHardwareDiscovery}"
                       Detail="{x:Static lang:Strings.OpenHardwareDiscoveryDetail}"
                       Command="{Binding OpenHardwareDiscovery}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Share}"
                       Label="{x:Static lang:Strings.QuickHardwareSnapshot}"
                       Detail="{Binding QuickSnapshotDetail}"
                       Command="{Binding RunQuickSnapshot}" />

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.DeveloperDiagnosticsHeading}"
                   Margin="4,12,0,10" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Chip}"
                       Label="{x:Static lang:Strings.CheckEnvironment}"
                       Detail="{Binding EnvironmentDetail}"
                       Command="{Binding RunEnvironmentCheck}" />

        <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.Control}"
                Padding="14,12" Margin="0,0,0,8" Visibility="{Binding EnvironmentSummaryVisibility}">
          <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                     Text="{Binding EnvironmentSummary}" TextWrapping="Wrap" TextTrimming="None"
                     FontFamily="Consolas" FontSize="11.5" />
        </Border>

        <controls:Tile Style="{StaticResource Tile.Switch}"
                       Glyph="{x:Static theme:Glyphs.Developer}"
                       Label="{x:Static lang:Strings.IncludeHardwareInLogs}"
                       Detail="{x:Static lang:Strings.IncludeHardwareInLogsDetail}"
                       IsOn="{Binding IncludeHardwareInLogs}"
                       Command="{Binding ToggleIncludeHardwareInLogs}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
