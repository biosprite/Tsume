<UserControl x:Class="Tsume.App.Panel.LevelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             Focusable="False">

  <StackPanel DataContext="{Binding Levels}">

    <controls:LevelSlider Glyph="{x:Static theme:Glyphs.Brightness}" Unit="%"
                          Maximum="100"
                          Value="{Binding Brightness}" />

    <controls:LevelSlider Glyph="{Binding VolumeGlyph}" Unit="%"
                          Maximum="100"
                          Value="{Binding Volume}"
                          Margin="0,8,0,0" />
  </StackPanel>

</UserControl>
