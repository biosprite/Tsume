<UserControl x:Class="Tsume.App.Panel.RtssScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             xmlns:vm="clr-namespace:Tsume.App.ViewModels"
             Focusable="False">

  <!-- RTSS: Essential performance overlay via RTSS's OverlayEditor (optional — can leave the user's own overlay alone),
       global frame-rate cap, and a link to the download page (install, Guru3D, uninstall). -->

  <DockPanel DataContext="{Binding Rtss}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.Rtss}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
               Text="{Binding Status}" Margin="4,12,0,0" />

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel controls:Screen.TakesFocus="True">

        <!-- Small warning about playing live online games with RTSS running. -->
        <Border Style="{StaticResource Card.Warning}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="15"
                       Foreground="{StaticResource Signal.Warn}" VerticalAlignment="Top" Margin="0,1,10,0"
                       Text="{x:Static theme:Glyphs.Warning}" />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                       TextWrapping="Wrap" TextTrimming="None"
                       Text="{x:Static lang:Strings.RtssOnlineWarning}" />
          </DockPanel>
        </Border>

        <!-- Shown when RivaTuner Statistics Server is not installed on this PC. -->
        <StackPanel Visibility="{Binding NotInstalledVisibility}">

          <Border Style="{StaticResource Card.Note}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="None"
                         Text="{x:Static lang:Strings.RtssNotInstalledTitle}" />
              <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Faint}"
                         TextWrapping="Wrap" TextTrimming="None"
                         Text="{x:Static lang:Strings.RtssNotInstalledExplained}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <!-- Install still in flight (the panel was reopened partway): ring and current stage. -->
          <Border Style="{StaticResource Card.Info}"
                  Background="{x:Static theme:Accent.Tint}"
                  BorderBrush="{x:Static theme:Accent.Wash}"
                  Padding="16,12"
                  Visibility="{Binding BusyVisibility}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:ProgressRing Grid.Column="0" Width="16" Height="16" RingThickness="2"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Foreground="{x:Static theme:Accent.Brush}"
                                     TrackBrush="{DynamicResource Switch.Groove}"
                                     IsActive="{Binding IsBusy}" />
              <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                         Text="{Binding BusyText}"
                         TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Opens the download page: automatic install, or Guru3D's own page. -->
          <controls:Tile Style="{StaticResource Tile.Link}"
                         Glyph="{x:Static theme:Glyphs.Download}"
                         Label="{Binding DownloadPageLabel}"
                         Detail="{Binding DownloadPageDetail}"
                         Command="{Binding Download.Open}" />

        </StackPanel>

        <!-- Shown once RTSS is installed. -->
        <StackPanel Visibility="{Binding InstalledVisibility}">

          <!-- Start RTSS when it is not running. -->
          <controls:Reveal IsOpen="{Binding IsNotRunning}">
            <controls:Tile Style="{StaticResource Tile.Link}" Tag=""
                           Glyph="{x:Static theme:Glyphs.Startup}"
                           Label="{x:Static lang:Strings.RtssStart}"
                           Detail="{Binding RtssAppDetail}"
                           Command="{Binding StartRtss}" />
          </controls:Reveal>

          <!-- Only shown while RTSS is running: Open/End actions, overlay options, and frame-rate cap. -->
          <controls:Reveal IsOpen="{Binding IsRunning}">
            <StackPanel>

              <UniformGrid Columns="2" Margin="-4,0,-4,14">
                <controls:Tile Style="{StaticResource Tile.Mini}"
                               Glyph="{x:Static theme:Glyphs.GameMenu}"
                               Label="{x:Static lang:Strings.RtssOpenMenu}"
                               Command="{Binding OpenRtssMenu}" />

                <controls:Tile Style="{StaticResource Tile.Mini}"
                               Foreground="{StaticResource Signal.Danger}"
                               Glyph="{x:Static theme:Glyphs.Quit}"
                               Label="{x:Static lang:Strings.RtssClose}"
                               Command="{Binding CloseRtss}" />
              </UniformGrid>

              <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.RtssOverlayHeading}"
                         Margin="4,10,0,10" />

              <!-- Lets the user opt out of Tsume's overlay and keep their own RTSS layout untouched. -->
              <controls:Tile Style="{StaticResource Tile.Switch}"
                             Glyph="{x:Static theme:Glyphs.Overlay}"
                             Label="{x:Static lang:Strings.RtssUseTsumeOverlay}"
                             Detail="{Binding UseTsumeOverlayDetail}"
                             IsOn="{Binding UseTsumeOverlay}"
                             Command="{Binding ToggleUseTsumeOverlay}" />

              <!-- Level and theme of the Essential layouts RTSS's OverlayEditor draws. -->
              <controls:Reveal IsOpen="{Binding UseTsumeOverlay}">
                <StackPanel>

                  <controls:SegmentedControl AutomationProperties.Name="{x:Static lang:Strings.RtssOverlayHeading}"
                                             Segments="{Binding Levels}" SelectedIndex="{Binding LevelIndex}" />

                  <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                             Text="{Binding LevelDetail}" Margin="6,6,6,0" />

                  <controls:Reveal IsOpen="{Binding HasSharedMemoryConflict}">
                    <Border Style="{StaticResource Card.Warning}" Margin="0,10,0,0">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="15"
                                   Foreground="{StaticResource Signal.Warn}" VerticalAlignment="Top" Margin="0,1,10,0"
                                   Text="{x:Static theme:Glyphs.Warning}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                                   TextWrapping="Wrap" TextTrimming="None"
                                   Text="{Binding SharedMemoryConflictText}" />
                      </DockPanel>
                    </Border>
                  </controls:Reveal>

                  <controls:Reveal IsOpen="{Binding IsTsumeOverlayShown}">
                    <StackPanel>
                      <!-- Per-level 3x3 screen alignment picker: each FPS overlay remembers its own position. -->
                      <Border Background="{DynamicResource Surface}"
                              CornerRadius="{StaticResource Radius.Control}"
                              Padding="14,12,14,12" Margin="0,10,0,0">
                        <StackPanel>
                          <DockPanel Margin="4,0,4,10">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"
                                       Foreground="{x:Static theme:Accent.Brush}" VerticalAlignment="Center"
                                       Text="{Binding ActiveAlignmentLabel}" />
                            <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                                       Text="{Binding PositionHeading}" />
                          </DockPanel>

                          <Border Background="{DynamicResource Sheet.Fill}"
                                  BorderBrush="{DynamicResource Panel.Edge}" BorderThickness="1"
                                  CornerRadius="{StaticResource Radius.Thumb}" Padding="6">
                            <ItemsControl ItemsSource="{Binding AlignmentOptions}" Focusable="False">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <UniformGrid Columns="3" Rows="3" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Command="{Binding Select}"
                                          AutomationProperties.Name="{Binding Label}"
                                          ToolTip="{Binding Label}"
                                          Height="34" Margin="3" FocusVisualStyle="{x:Null}"
                                          Cursor="Hand">
                                    <Button.Template>
                                      <ControlTemplate TargetType="Button">
                                        <Grid>
                                          <Border x:Name="Cell" CornerRadius="6"
                                                  Background="{DynamicResource Surface}"
                                                  BorderBrush="Transparent" BorderThickness="1.5"
                                                  Padding="7,6">
                                            <Border x:Name="Pill" Width="18" Height="7" CornerRadius="3.5"
                                                    Background="{DynamicResource Text.Faint}"
                                                    HorizontalAlignment="{Binding Horizontal}"
                                                    VerticalAlignment="{Binding Vertical}" />
                                          </Border>
                                          <Border x:Name="Ring" Style="{StaticResource Focus.Ring}"
                                                  CornerRadius="6" BorderBrush="{x:Static theme:Accent.Brush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                          <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                          </Trigger>
                                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Cell" Property="Background" Value="{x:Static theme:Accent.Tint}" />
                                            <Setter TargetName="Cell" Property="BorderBrush" Value="{x:Static theme:Accent.Brush}" />
                                            <Setter TargetName="Pill" Property="Background" Value="{x:Static theme:Accent.Brush}" />
                                          </DataTrigger>
                                          <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Ring.Show}" /></Trigger.EnterActions>
                                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Ring.Hide}" /></Trigger.ExitActions>
                                          </Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </Button.Template>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </StackPanel>
                      </Border>

                      <controls:Tile Style="{StaticResource Tile.Switch}" Margin="0,8,0,0"
                                     Glyph="{x:Static theme:Glyphs.Touch}"
                                     Label="{x:Static lang:Strings.RtssTouchDrag}"
                                     Detail="{x:Static lang:Strings.RtssTouchDragDetail}"
                                     IsOn="{Binding TouchDragEnabled}"
                                     Command="{Binding ToggleTouchDrag}" />
                    </StackPanel>
                  </controls:Reveal>

                </StackPanel>
              </controls:Reveal>

              <!-- When not using Tsume's overlay: simple toggle for the user's own RTSS OSD. -->
              <controls:Reveal IsOpen="{Binding UsesCustomOverlay}">
                <controls:Tile Style="{StaticResource Tile.Switch}" Margin="0"
                               Glyph="{x:Static theme:Glyphs.Counter}"
                               Label="{x:Static lang:Strings.RtssShowOwnOsd}"
                               Detail="{x:Static lang:Strings.RtssShowOwnOsdDetail}"
                               IsOn="{Binding IsOsdVisible}"
                               Command="{Binding ToggleOsdVisible}" />
              </controls:Reveal>

              <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.RtssFrameCapHeading}"
                         Margin="4,22,0,10" />

              <controls:SegmentedControl AutomationProperties.Name="{x:Static lang:Strings.RtssFrameCapHeading}"
                                         Segments="{Binding FrameCapModes}" SelectedIndex="{Binding FrameCapIndex}" />

              <controls:Reveal IsOpen="{Binding ShowsCustomCapSlider}">
                <controls:LevelSlider Glyph="{x:Static theme:Glyphs.RefreshRate}"
                                      Label="{x:Static lang:Strings.RtssCapSlider}" Unit=" FPS"
                                      AutomationProperties.Name="{x:Static lang:Strings.RtssCapSlider}"
                                      Minimum="{x:Static vm:RtssViewModel.MinCustomFps}"
                                      Maximum="{x:Static vm:RtssViewModel.MaxCustomFps}"
                                      LargeChange="1"
                                      Value="{Binding CustomCap}"
                                      Margin="0,8,0,0" />
              </controls:Reveal>

              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                         Text="{x:Static lang:Strings.RtssCapNote}" Margin="6,6,6,0" />

            </StackPanel>
          </controls:Reveal>

          <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.RtssAppHeading}"
                     Margin="4,18,0,10" />

          <controls:Tile Style="{StaticResource Tile.Switch}"
                         Glyph="{x:Static theme:Glyphs.Startup}"
                         Label="{x:Static lang:Strings.StartWithWindows}"
                         Detail="{x:Static lang:Strings.RtssStartWithWindowsDetail}"
                         IsOn="{Binding StartsWithWindows}"
                         Command="{Binding ToggleStartWithWindows}" />

          <controls:Tile Style="{StaticResource Tile.Switch}"
                         Glyph="{x:Static theme:Glyphs.Shield}"
                         Label="{x:Static lang:Strings.RtssSkipAntiCheat}"
                         Detail="{Binding SkipAntiCheatDetail}"
                         IsOn="{Binding SkipAntiCheatGames}"
                         Command="{Binding ToggleSkipAntiCheat}" />

          <controls:Tile Style="{StaticResource Tile.Link}"
                         Glyph="{x:Static theme:Glyphs.Download}"
                         Label="{Binding DownloadPageLabel}"
                         Detail="{Binding DownloadPageDetail}"
                         Command="{Binding Download.Open}" />

        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
