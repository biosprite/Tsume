<UserControl x:Class="Tsume.App.Panel.UpscalingScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- OptiScaler: the list of games. Each row opens that game's page. -->

  <DockPanel DataContext="{Binding Upscaling}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <controls:Tile DockPanel.Dock="Right" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Update}"
                     ToolTip="{x:Static lang:Strings.RescanGames}"
                     AutomationProperties.Name="{x:Static lang:Strings.RescanGames}"
                     IsEnabled="{Binding IsIdle}"
                     Command="{Binding Rescan}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.OptiScaler}"
                 Margin="16,0,12,0" VerticalAlignment="Center" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <Border Height="1" Background="{DynamicResource Surface.Divider}" Margin="6,12,6,8" />

      <UniformGrid Columns="2" Margin="-4,0,-4,-4">
        <controls:Tile Style="{StaticResource Tile.Row}"
                       Glyph="{x:Static theme:Glyphs.Add}" Label="{x:Static lang:Strings.AddGame}"
                       Command="{Binding Browse.OpenGame}" />
        <controls:Tile Style="{StaticResource Tile.Row}"
                       Glyph="{x:Static theme:Glyphs.Folder}" Label="{x:Static lang:Strings.AddFolder}"
                       Detail="{Binding FoldersLine}"
                       Command="{Binding Browse.OpenFolder}" />
      </UniformGrid>
    </StackPanel>

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <UniformGrid Columns="2" Margin="-4,0,-4,14">
          <controls:Tile Style="{StaticResource Tile.Mini}"
                         Glyph="{x:Static theme:Glyphs.Share}"
                         Label="{x:Static lang:Strings.OptiScalerCompatibility}"
                         Command="{Binding OpenOptiScalerCompatibility}" />
          <controls:Tile Style="{StaticResource Tile.Mini}"
                         Glyph="{x:Static theme:Glyphs.Share}"
                         Label="{x:Static lang:Strings.OptiPatcherCompatibility}"
                         Command="{Binding OpenOptiPatcherCompatibility}" />
        </UniformGrid>

        <DockPanel Margin="4,0,4,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding ScanStatusShown}">
            <controls:ProgressRing Width="12" Height="12" RingThickness="1.8"
                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{x:Static theme:Accent.Brush}"
                                   TrackBrush="{DynamicResource Switch.Groove}"
                                   IsActive="{Binding IsLooking}"
                                   Visibility="{Binding IsLookingShown}" />
            <TextBlock Style="{StaticResource Text.Caption}" FontSize="11"
                       Foreground="{DynamicResource Text.Muted}"
                       Text="{Binding ScanStatus}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Style="{StaticResource Text.Heading}" Margin="0"
                     Text="{x:Static lang:Strings.GamesHeading}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Focus lands on the first game, or on Back when none are listed. -->
        <ItemsControl ItemsSource="{Binding Games}" Focusable="False" controls:Screen.TakesFocus="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:Tile Style="{StaticResource Tile.GameLink}"
                             Glyph="{Binding Glyph}" Label="{Binding Name}"
                             AutomationProperties.HelpText="{Binding Detail}"
                             IsOn="{Binding IsInstalled}"
                             Command="{Binding Open}">
                <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" Margin="0,0,0,-4">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,5,4">
                        <!-- Slightly rounded rectangular tag: Installed (soft green) -->
                        <Border Background="#1A4ADE80" BorderBrush="#4C4ADE80"
                                BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding SuccessShown}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="10"
                                       Foreground="#FF6EE7A0"
                                       Text="{Binding Glyph}" Visibility="{Binding GlyphShown}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#FF6EE7A0"
                                       Text="{Binding Text}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>

                        <!-- Slightly rounded rectangular tag: OptiPatcher (live accent brushes set directly). -->
                        <Border Background="{x:Static theme:Accent.Tint}"
                                BorderBrush="{x:Static theme:Accent.Wash}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding AccentShown}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="10"
                                       Foreground="{x:Static theme:Accent.Brush}"
                                       Text="{Binding Glyph}" Visibility="{Binding GlyphShown}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{x:Static theme:Accent.Brush}"
                                       Text="{Binding Text}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>

                        <!-- Slightly rounded rectangular tag: Date / Upscaler / Anti-cheat name -->
                        <Border Background="{DynamicResource Surface.Hover}"
                                BorderBrush="{DynamicResource Surface.Divider}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding NeutralShown}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="10"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{Binding Glyph}" Visibility="{Binding GlyphShown}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{Binding Text}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>

                        <!-- Slightly rounded rectangular tag: Update ready / Needs repair / Interrupted / Folder missing -->
                        <Border Background="#1AF5B841" BorderBrush="#4CF5B841"
                                BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding WarningShown}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="10"
                                       Foreground="#FFE5A93B"
                                       Text="{Binding Glyph}" Visibility="{Binding GlyphShown}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#FFE5A93B"
                                       Text="{Binding Text}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>

                        <!-- Slightly rounded rectangular tag: Blocked -->
                        <Border Background="#1AE05555" BorderBrush="#4CE05555"
                                BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding DangerShown}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="10"
                                       Foreground="#FFE06868"
                                       Text="{Binding Glyph}" Visibility="{Binding GlyphShown}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#FFE06868"
                                       Text="{Binding Text}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </controls:Tile>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- "Still looking" or "nothing found"; empty once there are games. -->
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding EmptyNote}" Margin="4,0,4,0" />

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.ToolsHeading}"
                   Margin="4,16,0,10" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Download}"
                       Label="{x:Static lang:Strings.OptiScalerBuild}"
                       Detail="{Binding BuildLine}"
                       Command="{Binding Build.Open}" />

        <controls:Tile Style="{StaticResource Tile.Link}" Tag=""
                       Glyph="{x:Static theme:Glyphs.GameMenu}"
                       Label="{x:Static lang:Strings.OpenGameMenu}"
                       Detail="{x:Static lang:Strings.OpenGameMenuDetail}"
                       Command="{Binding OpenGameMenu}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Sliders}"
                       Label="{x:Static lang:Strings.Defaults}"
                       Detail="{x:Static lang:Strings.DefaultsDetail}"
                       Command="{Binding Defaults.Open}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Remove}"
                       Label="{x:Static lang:Strings.RestoreAllGames}"
                       Detail="{Binding RestoreAll.Line}"
                       Command="{Binding RestoreAll.Ask}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
