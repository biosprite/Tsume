<UserControl x:Class="Tsume.App.Panel.UpscalingScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tsume.App.Controls"
             xmlns:theme="clr-namespace:Tsume.App.Theme"
             xmlns:lang="clr-namespace:Tsume.App.Language"
             Focusable="False">

  <!-- OptiScaler: the list of games. Each row opens that game's page. -->

  <DockPanel DataContext="{Binding Upscaling}">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <controls:Tile DockPanel.Dock="Left" Style="{StaticResource Tile.Icon}"
                     Glyph="{x:Static theme:Glyphs.Back}"
                     AutomationProperties.Name="{x:Static lang:Strings.Back}"
                     Command="{Binding Close}" />

      <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.OptiScaler}"
                 Margin="16,0,0,0" VerticalAlignment="Center" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <Border Height="1" Background="{DynamicResource Surface.Divider}" Margin="6,12,6,8" />

      <UniformGrid Columns="2" Margin="-4,0,-4,-4">
        <controls:Tile Style="{StaticResource Tile.Row}"
                       Glyph="{x:Static theme:Glyphs.Add}" Label="{x:Static lang:Strings.AddGame}"
                       Command="{Binding Browse.Open}" />
        <controls:Tile Style="{StaticResource Tile.Row}"
                       Glyph="{x:Static theme:Glyphs.Sliders}" Label="{x:Static lang:Strings.Defaults}"
                       Command="{Binding Defaults.Open}" />
      </UniformGrid>
    </StackPanel>

    <ScrollViewer x:Name="List" Focusable="False"
                  VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
      <StackPanel>

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.GamesHeading}" />

        <!-- Focus lands on the first game, or on Back when none are listed. -->
        <ItemsControl ItemsSource="{Binding Games}" Focusable="False" controls:Screen.TakesFocus="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:Tile Style="{StaticResource Tile.Link}"
                             Glyph="{Binding Glyph}" Label="{Binding Name}" Detail="{Binding Detail}"
                             IsOn="{Binding IsInstalled}"
                             Command="{Binding Open}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- "Still looking" or "nothing found"; empty once there are games. -->
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding EmptyNote}" Margin="4,0,4,0" />

        <TextBlock Style="{StaticResource Text.Heading}" Text="{x:Static lang:Strings.ToolsHeading}"
                   Margin="4,16,0,10" />

        <controls:Tile Style="{StaticResource Tile.Link}" Tag=""
                       Glyph="{x:Static theme:Glyphs.GameMenu}"
                       Label="{x:Static lang:Strings.OpenGameMenu}"
                       Detail="{x:Static lang:Strings.OpenGameMenuDetail}"
                       Command="{Binding OpenGameMenu}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Download}"
                       Label="{x:Static lang:Strings.OptiScalerBuild}"
                       Detail="{Binding BuildLine}"
                       Command="{Binding Build.Open}" />

        <controls:Tile Style="{StaticResource Tile.Link}"
                       Glyph="{x:Static theme:Glyphs.Remove}"
                       Label="{x:Static lang:Strings.RestoreAllGames}"
                       Detail="{Binding RestoreAll.Line}"
                       Command="{Binding RestoreAll.Ask}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
