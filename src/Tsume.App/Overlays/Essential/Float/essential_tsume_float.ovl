[Source13]
Name=GPU1 memory usage
Units=GB
Format=%.1f
Formula=(validate("HAL GPU1 memory usage") ? ("HAL GPU1 memory usage" > 0 ? "HAL GPU1 memory usage" : x) : x) / 1024
Provider=AIDA
ID=TSUME_GPU_VRAM
[Source14]
Name=Temp warn threshold
Units=°C
Format=%.0f
Formula=validate(x) ? x : 75
Provider=AIDA
