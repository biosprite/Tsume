[Source11]
Name=CPU clock
Units=GHz
Format=%.2f
Formula=(validate("HAL CPU clock") ? "HAL CPU clock" : x) / 1000
Provider=AIDA
ID=TSUME_CPU_CLOCK
[Source12]
Name=GPU1 power
Units=W
Format=
Formula=(validate("HAL GPU1 power") ? "HAL GPU1 power" : x)
Provider=AIDA
ID=TSUME_GPU_POWER
[Source13]
Name=GPU1 memory usage
Units=GB
Format=%.1f
Formula=(validate("HAL GPU1 memory usage") ? ("HAL GPU1 memory usage" > 0 ? "HAL GPU1 memory usage" : x) : x) / 1024
Provider=AIDA
ID=TSUME_GPU_VRAM
[Source14]
Name=Temp warn threshold
Units=°C
Format=%.0f
Formula=validate(x) ? x : 75
Provider=AIDA
ID=TSUME_TEMP_WARN
[Source15]
Name=Temp hot threshold
Units=°C
Format=%.0f
Formula=validate(x) ? x : 85
Provider=AIDA
ID=TSUME_TEMP_HOT
[Source16]
Name=Temperature tier
Units=
Format=%.0f
Formula=validate("CPU temperature") ? ("CPU temperature" >= "Temp hot threshold" ? 2 : ("CPU temperature" >= "Temp warn threshold" ? 1 : 0)) : 0
Provider=AIDA
ID=TSUME_OVERLAY_LEVEL
