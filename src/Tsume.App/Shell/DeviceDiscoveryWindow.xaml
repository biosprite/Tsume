<Window x:Class="Tsume.App.Shell.DeviceDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Tsume.App.Theme"
        xmlns:lang="clr-namespace:Tsume.App.Language"
        xmlns:ctrl="clr-namespace:Tsume.App.Controls"
        Title="Tsume Hardware Discovery"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Panel.Fill}"
        Foreground="{DynamicResource Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="Dev.Button" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Panel.Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Words}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Dev.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Dev.Button}">
      <Setter Property="Foreground" Value="#FF0B0D11" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{x:Static theme:Accent.Brush}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Dev.TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Words}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Dev.Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Panel.Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource Panel.Fill}" Padding="20,16">
    <DockPanel>

      <!-- Top Header -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <!-- Mode tabs -->
        <Border DockPanel.Dock="Right" Background="{DynamicResource Surface}" CornerRadius="12" Padding="4"
                VerticalAlignment="Center" Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Dev.TabButton}" GroupName="ModeTabs" Content="Quick Scan"
                         IsChecked="{Binding IsQuickScanTab, Mode=OneWay}" Click="OnSelectQuickScan" />
            <RadioButton Style="{StaticResource Dev.TabButton}" GroupName="ModeTabs" Content="Guided Capture"
                         IsChecked="{Binding IsGuidedTab, Mode=OneWay}" Click="OnSelectGuided" />
            <RadioButton Style="{StaticResource Dev.TabButton}" GroupName="ModeTabs" Content="Live Watch"
                         IsChecked="{Binding IsWatchTab, Mode=OneWay}" Click="OnSelectWatch" />
            <RadioButton Style="{StaticResource Dev.TabButton}" GroupName="ModeTabs" Content="Report Preview"
                         IsChecked="{Binding IsPreviewTab, Mode=OneWay}" Click="OnSelectPreview" />
          </StackPanel>
        </Border>

        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Icon}" Text="{x:Static theme:Glyphs.Developer}"
                       Foreground="{x:Static theme:Accent.Brush}" FontSize="20" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource Text.Title}" Text="{x:Static lang:Strings.HardwareDiscoveryTitle}" />
            <Border Background="{x:Static theme:Accent.Tint}" BorderBrush="{x:Static theme:Accent.Wash}"
                    BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Caption}" Text="100% READ-ONLY"
                         Foreground="{x:Static theme:Accent.Brush}" FontWeight="Bold" FontSize="10" />
            </Border>
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static lang:Strings.HardwareDiscoverySubtitle}"
                     Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Status strip -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="{x:Static theme:Glyphs.Info}"
                     FontSize="14" Foreground="{x:Static theme:Accent.Brush}" Margin="0,0,8,0" />
          <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                     Text="{Binding StatusBanner}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- Persistent Bottom Action Bar -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Surface.Divider}" BorderThickness="0,1,0,0"
              Padding="0,12,0,0" Margin="0,12,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Button Style="{StaticResource Dev.Button}" Content="Environment Check" Margin="0,0,8,0"
                    IsEnabled="{Binding IsNotBusy}" Command="{Binding RunEnvCheckCommand}" />
            <Button Style="{StaticResource Dev.PrimaryButton}" Content="Export Support Bundle (.zip)"
                    IsEnabled="{Binding IsNotBusy}" Command="{Binding ExportBundleCommand}" />
          </StackPanel>

          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SummaryPill}" FontSize="12.5" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ExportMessage}"
                       Foreground="{StaticResource Signal.Good}" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Main Body (4 switchable views) -->
      <Grid>

        <!-- TAB 0: QUICK SCAN (HANDS-FREE) -->
        <ScrollViewer Visibility="{Binding IsQuickScanTab, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Dev.Card}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Dev.PrimaryButton}"
                        Content="Run Quick Scan" Padding="20,12" Margin="16,0,0,0" VerticalAlignment="Center"
                        IsEnabled="{Binding IsNotBusy}" Command="{Binding RunQuickScanCommand}" />
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Body}" Text="Hands-Free Automatic Discovery (~10 seconds)" FontSize="15" />
                  <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                             Text="Captures SMBIOS/CPU/GPU identity, display timings, Windows power plan &amp; boost mode, vendor WMI classes + MOF schemas, safe OEM firmware reads, a 3-second live-telemetry load delta, full HID/XInput/LampArray/controller topology, and OEM software footprint." />
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="Include 3-second CPU load delta (identifies live temp/fan/power bytes)"
                              IsChecked="{Binding IncludeTimedLoad}" Foreground="{DynamicResource Text}" Margin="0,0,18,4" />
                    <CheckBox Content="Allow UAC fallback if Helper service is offline"
                              IsChecked="{Binding AllowUacFallback}" Foreground="{DynamicResource Text}" Margin="0,0,0,4" />
                  </WrapPanel>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Dev.Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Heading}" Text="SYSTEM IDENTITY" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding QuickIdentityText}" TextWrapping="Wrap" FontWeight="Normal" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Dev.Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Heading}" Text="FIRMWARE &amp; WMI SURFACE" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding QuickFirmwareText}" TextWrapping="Wrap" FontWeight="Normal" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Dev.Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Heading}" Text="WINDOWS POWER, BOOST MODE &amp; DISPLAY" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding QuickPowerDisplayText}" TextWrapping="Wrap" FontWeight="Normal" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Dev.Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Heading}" Text="CONTROLLERS, HID &amp; LIGHTING" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding QuickHidText}" TextWrapping="Wrap" FontWeight="Normal" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Dev.Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Heading}" Text="OEM SOFTWARE FOOTPRINT" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding QuickOemText}" TextWrapping="Wrap" FontWeight="Normal" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- TAB 1: GUIDED CAPTURE (11-STEP INTERACTIVE WIZARD) -->
        <Grid Visibility="{Binding IsGuidedTab, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Step list -->
          <Border Grid.Column="0" Style="{StaticResource Dev.Card}" Margin="0" Padding="8">
            <DockPanel>
              <!-- Guided progress header -->
              <StackPanel DockPanel.Dock="Top" Margin="6,2,6,8">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding GuidedProgressText}" FontSize="11" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasGuidedProgress}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Signal.Good}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Style="{StaticResource Text.Heading}" Text="STEPS" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar Height="4" Minimum="0" Maximum="{Binding Steps.Count, Mode=OneWay}"
                             Value="{Binding GuidedCapturedCount, Mode=OneWay}" Margin="0,6,0,0">
                  <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                      <Border x:Name="PART_Track" Background="{DynamicResource Surface.Hover}" CornerRadius="2">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{StaticResource Signal.Good}" CornerRadius="2" />
                      </Border>
                    </ControlTemplate>
                  </ProgressBar.Template>
                </ProgressBar>
              </StackPanel>

              <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0"
                       ScrollViewer.CanContentScroll="False"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,3" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                  BorderThickness="1" CornerRadius="9" Padding="8,5" Cursor="Hand">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCaptured}" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="#123DDC97" />
                              <Setter TargetName="Bd" Property="BorderBrush" Value="#303DDC97" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
                              <Setter TargetName="Bd" Property="BorderBrush" Value="{x:Static theme:Accent.Brush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <!-- Step number / captured checkmark circle -->
                      <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                              VerticalAlignment="Center" Margin="0,0,10,0" BorderThickness="1">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Surface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Panel.Edge}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{x:Static theme:Accent.Tint}" />
                                <Setter Property="BorderBrush" Value="{x:Static theme:Accent.Brush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Surface.Divider}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsCaptured}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Signal.Good}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Signal.Good}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <TextBlock Text="{Binding Number, Mode=OneWay}"
                                     FontFamily="{StaticResource Font.Words}" FontSize="11" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Foreground" Value="{x:Static theme:Accent.Brush}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsCaptured}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <TextBlock Text="{x:Static theme:Glyphs.Tick}"
                                     FontFamily="{StaticResource Font.Icons}" FontSize="11" FontWeight="Bold"
                                     Foreground="#FF0B0D11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding IsCaptured, Converter={StaticResource BoolToVis}}" />

                          <TextBlock Text="–"
                                     FontFamily="{StaticResource Font.Words}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                      </Border>

                      <!-- Step title & status stacked cleanly -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="12"
                                   LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                   ToolTip="{Binding Title, Mode=OneWay}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                              <Setter Property="FontWeight" Value="Medium" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding SidebarStatus}" FontSize="10.5"
                                   LineHeight="13" LineStackingStrategy="BlockLineHeight" Margin="0,1,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                              <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCaptured}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Signal.Good}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <!-- Active step workspace -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Dev.Card}">
                <StackPanel>
                  <!-- Step metadata & status badges -->
                  <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right" Background="#1F3DDC97" BorderBrush="#553DDC97"
                            BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                            Visibility="{Binding SelectedStep.IsCaptured, Converter={StaticResource BoolToVis}}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static theme:Glyphs.Tick}" FontFamily="{StaticResource Font.Icons}"
                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource Signal.Good}"
                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SelectedStep.Status}"
                                   Foreground="{StaticResource Signal.Good}" FontWeight="SemiBold" FontSize="11" />
                      </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Panel.Edge}"
                            BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                            Visibility="{Binding SelectedStep.IsSkipped, Converter={StaticResource BoolToVis}}">
                      <TextBlock Style="{StaticResource Text.Caption}" Text="Skipped" FontSize="11" />
                    </Border>
                    <Border DockPanel.Dock="Right" Background="{x:Static theme:Accent.Tint}" BorderBrush="{x:Static theme:Accent.Wash}"
                            BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                            Visibility="{Binding SelectedStep.ShowStartBadge, Converter={StaticResource BoolToVis}}">
                      <TextBlock Style="{StaticResource Text.Caption}" Text="START HERE"
                                 Foreground="{x:Static theme:Accent.Brush}" FontWeight="Bold" FontSize="10" />
                    </Border>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Panel.Edge}"
                            BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                            Visibility="{Binding SelectedStep.ShowOptionalBadge, Converter={StaticResource BoolToVis}}">
                      <TextBlock Style="{StaticResource Text.Caption}" Text="OPTIONAL"
                                 Foreground="{DynamicResource Text.Muted}" FontWeight="SemiBold" FontSize="10" />
                    </Border>

                    <TextBlock Style="{StaticResource Text.Heading}" Margin="0" VerticalAlignment="Center">
                      <Run Text="STEP " /><Run Text="{Binding SelectedStep.Number, Mode=OneWay}" /><Run Text=" OF " /><Run Text="{Binding Steps.Count, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SelectedStep.Category, Mode=OneWay}" />
                    </TextBlock>
                  </DockPanel>

                  <!-- Step title header with icon & plain-English goal -->
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="{x:Static theme:Accent.Tint}" BorderBrush="{x:Static theme:Accent.Wash}"
                            BorderThickness="1" VerticalAlignment="Top" Margin="0,1,12,0">
                      <TextBlock Text="{Binding SelectedStep.Glyph}" FontFamily="{StaticResource Font.Icons}"
                                 FontSize="17" Foreground="{x:Static theme:Accent.Brush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource Text.Title}" FontSize="20"
                                 Text="{Binding SelectedStep.Title}" TextWrapping="Wrap" />
                      <TextBlock Style="{StaticResource Text.Caption}" FontSize="13"
                                 Foreground="{DynamicResource Text.Muted}" Text="{Binding SelectedStep.Subtitle}"
                                 TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
                    </StackPanel>
                  </Grid>

                  <!-- Quick-glance target values to apply -->
                  <ItemsControl ItemsSource="{Binding SelectedStep.Targets}"
                                Visibility="{Binding SelectedStep.HasTargets, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Panel.Edge}"
                                BorderThickness="1" CornerRadius="8" Padding="9,4,6,4" Margin="0,0,8,6">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="11.5"
                                       Foreground="{DynamicResource Text.Muted}" Text="{Binding Label}"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <Border Background="#FF0B0E14" BorderBrush="#40FFFFFF" BorderThickness="1,1,1,1.5"
                                    CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="9" Height="9" CornerRadius="4.5"
                                        Background="{Binding SwatchBrush}" BorderBrush="#55FFFFFF" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                        Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVis}}" />
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" Text="{Binding Value}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Structured numbered checklist ("What to do") -->
                  <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource Surface.Divider}"
                          BorderThickness="1" CornerRadius="11" Padding="14,11,14,5" Margin="0,2,0,10">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Text.Heading}" Text="WHAT TO DO" FontSize="10.5" Margin="0,0,0,9" />
                      <ItemsControl ItemsSource="{Binding SelectedStep.ActionSteps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                      Background="{x:Static theme:Accent.Tint}" BorderBrush="{x:Static theme:Accent.Wash}"
                                      BorderThickness="1" VerticalAlignment="Top" Margin="0,1,10,0">
                                <TextBlock Text="{Binding Number, Mode=OneWay}"
                                           FontFamily="{StaticResource Font.Words}" FontSize="11" FontWeight="Bold"
                                           Foreground="{x:Static theme:Accent.Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="13" FontWeight="SemiBold"
                                           ctrl:InlineCodeText.Text="{Binding Headline}"
                                           TextWrapping="Wrap" LineHeight="22" />
                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="12"
                                           Foreground="{DynamicResource Text.Muted}"
                                           ctrl:InlineCodeText.Text="{Binding Detail}"
                                           TextWrapping="Wrap" LineHeight="20" Margin="0,2,0,0"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border BorderBrush="{DynamicResource Surface.Divider}" BorderThickness="0,1,0,0"
                              Padding="0,8,0,6" Margin="0,1,0,0"
                              Visibility="{Binding SelectedStep.HasSkipHint, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="11.5"
                                   Foreground="{DynamicResource Text.Muted}"
                                   ctrl:InlineCodeText.Text="{Binding SelectedStep.SkipHint}"
                                   TextWrapping="Wrap" LineHeight="20" />
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- After-capture revert reminder (when applicable) -->
                  <Border Background="#16F5B841" BorderBrush="#44F5B841" BorderThickness="1"
                          CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                          Visibility="{Binding SelectedStep.HasAfterCaptureNote, Converter={StaticResource BoolToVis}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource Text.Icon}" Text="{x:Static theme:Glyphs.Update}"
                                 FontSize="13" Foreground="{StaticResource Signal.Warn}"
                                 VerticalAlignment="Top" Margin="0,2,9,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.Heading}" Text="AFTER CAPTURING"
                                   Foreground="{StaticResource Signal.Warn}" FontSize="10" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                                   ctrl:InlineCodeText.Text="{Binding SelectedStep.AfterCaptureNote}"
                                   TextWrapping="Wrap" LineHeight="20" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Plain-English explanation of why this step matters -->
                  <Border Background="{x:Static theme:Accent.Tint}" BorderBrush="{x:Static theme:Accent.Wash}"
                          BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource Text.Icon}" Text="{x:Static theme:Glyphs.Info}"
                                 FontSize="14" Foreground="{x:Static theme:Accent.Brush}"
                                 VerticalAlignment="Top" Margin="0,2,10,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.Heading}" Text="WHY THIS HELPS"
                                   Foreground="{x:Static theme:Accent.Brush}" FontSize="10" Margin="0,0,0,3" />
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                                   Text="{Binding SelectedStep.WhyItMatters}" TextWrapping="Wrap" LineHeight="18" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Button capture step controls -->
                  <StackPanel Visibility="{Binding IsButtonStepSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <DockPanel Margin="0,4,0,8">
                      <Button DockPanel.Dock="Right" Style="{StaticResource Dev.PrimaryButton}"
                              Content="{Binding ButtonListenLabel}" Margin="10,0,0,0"
                              IsEnabled="{Binding IsNotBusy}" Command="{Binding ToggleButtonListeningCommand}" />
                      <TextBlock Style="{StaticResource Text.Heading}" Text="SELECT WHICH BUTTON YOU ARE PRESSING"
                                 VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding ButtonPrompts}" SelectedItem="{Binding SelectedButtonPrompt, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0,0,6,6" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource Panel.Edge}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" Cursor="Hand">
                                  <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{x:Static theme:Accent.Tint}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{x:Static theme:Accent.Brush}" />
                                  </Trigger>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text}"
                                       Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#FF0B0E14" BorderBrush="#40FFFFFF" BorderThickness="1,1,1,1.5"
                                    CornerRadius="5" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                              <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Text.Muted}" Text="{Binding CodeTag}"
                                         VerticalAlignment="Center" />
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Background="#FF0A0C10" BorderBrush="{DynamicResource Panel.Edge}" BorderThickness="1"
                            CornerRadius="10" Padding="10" Height="175">
                      <ListBox ItemsSource="{Binding ButtonFeed}" Background="Transparent" BorderThickness="0"
                               Foreground="#FFE6ECF5" FontFamily="Consolas" FontSize="11.5" />
                    </Border>
                  </StackPanel>

                  <!-- Optional note (for non-button steps) -->
                  <StackPanel>
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsButtonStepSelected}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>

                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SelectedStep.NoteHint}"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox Text="{Binding StepUserNote, UpdateSourceTrigger=PropertyChanged}"
                             Background="#FF0B0D12" Foreground="#FFE6ECF5" CaretBrush="#FFE6ECF5"
                             BorderBrush="{DynamicResource Panel.Edge}" Padding="10,7" Margin="0,0,0,12" FontSize="13" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal">
                    <Button Content="Capture Step" Margin="0,0,8,0"
                            IsEnabled="{Binding IsNotBusy}" Command="{Binding CaptureStepCommand}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Dev.PrimaryButton}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsButtonStepSelected}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Dev.Button}" Content="Skip Step" Margin="0,0,8,0"
                            IsEnabled="{Binding IsNotBusy}" Command="{Binding SkipStepCommand}" />
                    <Button Style="{StaticResource Dev.Button}" Content="Previous" Margin="0,0,8,0"
                            IsEnabled="{Binding CanGoPrevious}" Command="{Binding PreviousStepCommand}" />
                    <Button Style="{StaticResource Dev.Button}" Content="Next"
                            IsEnabled="{Binding CanGoNext}" Command="{Binding NextStepCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Diff output card -->
              <Border Style="{StaticResource Dev.Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Heading}" Text="DETECTED DIFFERENCES FOR THIS STEP" Margin="0,0,0,6" />
                  <TextBox Text="{Binding SelectedStepDiffPreview, Mode=OneWay}" IsReadOnly="True"
                           Background="#FF0A0C10" Foreground="#FFE6ECF5" BorderThickness="0"
                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Padding="10" MinHeight="80" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- TAB 2: LIVE WATCH MODE -->
        <DockPanel Visibility="{Binding IsWatchTab, Converter={StaticResource BoolToVis}}">
          <Border DockPanel.Dock="Top" Style="{StaticResource Dev.Card}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Dev.PrimaryButton}"
                      Content="{Binding WatchButtonLabel}" Padding="20,12" Margin="16,0,0,0" VerticalAlignment="Center"
                      IsEnabled="{Binding IsNotBusy}" Command="{Binding ToggleWatchModeCommand}" />
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" Text="Live Watch Mode (Free-Form Recorder)" FontSize="15" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding WatchStatusText}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Dev.Card}" Margin="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Heading}" Text="LIVE TIMELINE (FIRMWARE / REGISTRY / HID DIFFS + BUTTON EVENTS)" Margin="0,0,0,8" />
              <ListBox ItemsSource="{Binding LiveFeed}" Background="#FF0A0C10" BorderBrush="{DynamicResource Panel.Edge}"
                       BorderThickness="1" Foreground="#FFE6ECF5" FontFamily="Consolas" FontSize="12" Padding="6" />
            </DockPanel>
          </Border>
        </DockPanel>

        <!-- TAB 3: REPORT PREVIEW (PRIVACY AUDIT) -->
        <DockPanel Visibility="{Binding IsPreviewTab, Converter={StaticResource BoolToVis}}">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                       Text="Audit exactly what will be saved in report.md before exporting. Serial numbers, usernames, and hostnames are scrubbed." />
            <Button DockPanel.Dock="Right" Style="{StaticResource Dev.Button}" Content="Refresh Preview"
                    HorizontalAlignment="Right" Command="{Binding RefreshPreviewCommand}" />
          </DockPanel>
          <TextBox Text="{Binding ReportPreviewText, Mode=OneWay}" IsReadOnly="True"
                   Background="#FF0A0C10" Foreground="#FFE6ECF5" BorderBrush="{DynamicResource Panel.Edge}"
                   BorderThickness="1" FontFamily="Consolas" FontSize="12" Padding="12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </DockPanel>

      </Grid>
    </DockPanel>
  </Border>
</Window>
