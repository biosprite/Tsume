<Window x:Class="Tsume.App.Shell.RtssOverlayDragWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Tsume.App.Theme"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False">

  <Grid x:Name="Root">

    <!-- Full-screen canvas holding the 9 alignment anchor dots and the smooth GPU-translated overlay frame. -->
    <Canvas x:Name="DragCanvas" ClipToBounds="False">

      <!-- 9 subtle snap anchor indicators (populated in code-behind for the active overlay size). -->
      <Canvas x:Name="SnapDotsLayer" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed" />

      <!-- Hit-testable overlay frame: invisible (#01000000) in standby mode, crisp glass+accent while dragging. -->
      <Border x:Name="OverlayBox"
              Background="#01000000"
              CornerRadius="10"
              BorderThickness="2"
              BorderBrush="Transparent"
              Cursor="SizeAll"
              IsManipulationEnabled="False">
        <Border.RenderTransform>
          <TranslateTransform x:Name="BoxTranslate" X="0" Y="0" />
        </Border.RenderTransform>

        <Grid x:Name="BoxChrome" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
          <Border CornerRadius="8" Background="{x:Static theme:Accent.Tint}" />

          <!-- Subtle center move icon while dragging. -->
          <Border Width="28" Height="28" CornerRadius="14"
                  Background="#B0141418"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Icon}"
                       FontSize="13"
                       Foreground="{x:Static theme:Accent.Brush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{x:Static theme:Glyphs.Move}" />
          </Border>
        </Grid>
      </Border>

      <!-- Live alignment / coordinate pill that tracks beside the dragged overlay. -->
      <Border x:Name="PositionBadge"
              Background="#D916161C"
              BorderBrush="{x:Static theme:Accent.Brush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="10,4"
              Opacity="0"
              Visibility="Collapsed"
              IsHitTestVisible="False">
        <Border.RenderTransform>
          <TranslateTransform x:Name="BadgeTranslate" X="0" Y="0" />
        </Border.RenderTransform>
        <TextBlock x:Name="BadgeText"
                   Style="{StaticResource Text.Caption}"
                   Foreground="#F5F5F7"
                   FontWeight="SemiBold" />
      </Border>

    </Canvas>

  </Grid>

</Window>
